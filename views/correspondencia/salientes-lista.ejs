<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css?v=12">
</head>
<body>
<%- include('../layout/sidebar') %>
<%
function fmtFecha(d) {
  if (!d) return '—';
  var s = d instanceof Date ? d.toISOString().split('T')[0] : String(d).split('T')[0];
  var p = s.split('-');
  var meses = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
  return parseInt(p[2]) + ' ' + meses[parseInt(p[1])-1] + ' ' + p[0];
}
var TIPO_LABEL = { oficio: 'Oficio', memorandum: 'Memorándum', circular: 'Circular' };
function tipoLabel(t) { return TIPO_LABEL[t] || t; }
function fmtDestinatario(d) { return d.destinatario || '—'; }
%>
<div class="main-wrapper">
  <div class="topbar">
    <h1><%= titulo %></h1>
    <div class="topbar-user">
      <span><%= usuario.nombre %></span>
    </div>
  </div>
  <div class="page-content">
    <% if (success && success.length) { %><div class="alert alert-success">✓ <%= success[0] %></div><% } %>
    <% if (error && error.length) { %><div class="alert alert-error">✕ <%= error[0] %></div><% } %>

    <div class="flex items-center justify-between mb-16">
      <div class="flex gap-8">
        <a href="/correspondencia/salientes/nuevo?tipo=oficio" class="btn btn-primary">+ Nuevo Oficio</a>
        <a href="/correspondencia/salientes/nuevo?tipo=memorandum" class="btn btn-secondary">+ Nuevo Memorándum</a>
        <a href="/correspondencia/salientes/nuevo?tipo=circular" class="btn btn-secondary">+ Nueva Circular</a>
      </div>
    </div>

    <form method="GET" class="filtros-bar">
      <input type="search" name="buscar" placeholder="Buscar por folio, asunto, destinatario..." value="<%= filtros.buscar || '' %>">
      <select name="tipo">
        <option value="">Todos los tipos</option>
        <option value="oficio" <%= filtros.tipo === 'oficio' ? 'selected' : '' %>>Oficio</option>
        <option value="memorandum" <%= filtros.tipo === 'memorandum' ? 'selected' : '' %>>Memorándum</option>
        <option value="circular" <%= filtros.tipo === 'circular' ? 'selected' : '' %>>Circular</option>
      </select>
      <select name="estatus">
        <option value="">Todos los estatus</option>
        <option value="borrador" <%= filtros.estatus === 'borrador' ? 'selected' : '' %>>Borrador</option>
        <option value="firmado" <%= filtros.estatus === 'firmado' ? 'selected' : '' %>>Firmado</option>
        <option value="enviado" <%= filtros.estatus === 'enviado' ? 'selected' : '' %>>Enviado</option>
        <option value="archivado" <%= filtros.estatus === 'archivado' ? 'selected' : '' %>>Archivado</option>
      </select>
      <button type="submit" class="btn btn-secondary">Filtrar</button>
      <a href="/correspondencia/salientes" class="btn btn-secondary">Limpiar</a>
    </form>

    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Folio</th><th>Tipo</th><th>Fecha</th><th>Destinatario</th>
              <th>Asunto</th><th>Área</th><th>Estatus</th><th>PDF</th><th></th>
            </tr>
          </thead>
          <tbody>
          <% if (documentos.length === 0) { %>
            <tr><td colspan="9" class="text-center text-gris" style="padding:30px">No hay documentos registrados</td></tr>
          <% } %>
          <% documentos.forEach(d => { %>
            <tr>
              <td><strong><%= d.numero_folio %></strong></td>
              <td><span class="badge badge-<%= d.tipo %>"><%= tipoLabel(d.tipo) %></span></td>
              <td><%= fmtFecha(d.fecha_emision) %></td>
              <td class="truncate" title="<%= d.destinatario %>"><%= fmtDestinatario(d) %></td>
              <td class="truncate"><%= d.asunto %></td>
              <td class="text-sm text-gris"><%= d.area_nombre || '—' %></td>
              <td><span class="badge badge-<%= d.estatus %>"><%= d.estatus %></span></td>
              <td>
                <% if (d.ruta_pdf) { %>
                  <a href="<%= d.ruta_pdf %>" target="_blank" class="btn btn-sm btn-secondary">PDF</a>
                <% } else { %>
                  <span class="text-gris text-sm">—</span>
                <% } %>
              </td>
              <td><a href="/correspondencia/salientes/<%= d.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>

      <% if (paginacion.pages > 1) { %>
      <div class="pagination mt-16">
        <% if (paginacion.page > 1) { %>
          <a href="?page=<%= paginacion.page-1 %>&buscar=<%= filtros.buscar||'' %>&tipo=<%= filtros.tipo||'' %>&estatus=<%= filtros.estatus||'' %>">‹</a>
        <% } %>
        <% for(let i=1; i<=paginacion.pages; i++) { %>
          <a href="?page=<%= i %>&buscar=<%= filtros.buscar||'' %>&tipo=<%= filtros.tipo||'' %>&estatus=<%= filtros.estatus||'' %>"
             class="<%= i === paginacion.page ? 'activo' : '' %>"><%= i %></a>
        <% } %>
        <% if (paginacion.page < paginacion.pages) { %>
          <a href="?page=<%= paginacion.page+1 %>&buscar=<%= filtros.buscar||'' %>&tipo=<%= filtros.tipo||'' %>&estatus=<%= filtros.estatus||'' %>">›</a>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</div>
<script src="/js/app.js"></script>
</body></html>
