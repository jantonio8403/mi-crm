<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<%- include('../layout/sidebar') %>
<%
function fmtFecha(d) {
  if (!d) return '—';
  var s = d instanceof Date ? d.toISOString().split('T')[0] : String(d).split('T')[0];
  var p = s.split('-');
  var meses = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
  return parseInt(p[2]) + ' ' + meses[parseInt(p[1])-1] + ' ' + p[0];
}
var TIPO_ENT_CLASS = {
  'oficio': 'oficio', 'memorandum': 'memorandum', 'circular': 'circular',
  'oficio-circular': 'circular', 'dictamen': 'dictamen', 'otro': 'otro'
};
var TIPO_ENT_LABEL = {
  'oficio': 'Oficio', 'memorandum': 'Memorándum', 'circular': 'Circular',
  'oficio-circular': 'Oficio-Circular', 'dictamen': 'Dictamen', 'otro': 'Otro'
};
%>
<div class="main-wrapper">
  <div class="topbar">
    <h1><%= titulo %></h1>
    <div class="topbar-user">
      <span><%= usuario.nombre %></span>
      <a href="/logout">Cerrar sesión</a>
    </div>
  </div>
  <div class="page-content">
    <% if (success && success.length) { %><div class="alert alert-success">✓ <%= success[0] %></div><% } %>
    <% if (error && error.length) { %><div class="alert alert-error">✕ <%= error[0] %></div><% } %>

    <div class="flex items-center justify-between mb-16">
      <% if (canRegister) { %>
        <a href="/correspondencia/entrante/nuevo" class="btn btn-primary">+ Registrar correspondencia</a>
      <% } else { %>
        <span></span>
      <% } %>
    </div>

    <form method="GET" class="filtros-bar">
      <input type="search" name="buscar" placeholder="Buscar por folio, asunto, remitente..." value="<%= filtros.buscar || '' %>">
      <select name="tipo">
        <option value="">Todos los tipos</option>
        <option value="oficio" <%= filtros.tipo==='oficio'?'selected':'' %>>Oficio</option>
        <option value="memorandum" <%= filtros.tipo==='memorandum'?'selected':'' %>>Memorándum</option>
        <option value="circular" <%= filtros.tipo==='circular'?'selected':'' %>>Circular</option>
        <option value="oficio-circular" <%= filtros.tipo==='oficio-circular'?'selected':'' %>>Oficio-Circular</option>
        <option value="dictamen" <%= filtros.tipo==='dictamen'?'selected':'' %>>Dictamen</option>
        <option value="otro" <%= filtros.tipo==='otro'?'selected':'' %>>Otro</option>
      </select>
      <select name="estatus">
        <option value="">Todos los estatus</option>
        <option value="recibido" <%= filtros.estatus==='recibido'?'selected':'' %>>Recibido</option>
        <option value="en_proceso" <%= filtros.estatus==='en_proceso'?'selected':'' %>>En proceso</option>
        <option value="atendido" <%= filtros.estatus==='atendido'?'selected':'' %>>Atendido</option>
        <option value="archivado" <%= filtros.estatus==='archivado'?'selected':'' %>>Archivado</option>
      </select>
      <button type="submit" class="btn btn-secondary">Filtrar</button>
      <a href="/correspondencia/entrante" class="btn btn-secondary">Limpiar</a>
    </form>

    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Folio ext.</th><th>Tipo</th><th>Recibido</th><th>Remitente</th>
              <th>Institución</th><th>Asunto</th><th>Área</th><th>Estatus</th><th>Resp.</th><th></th>
            </tr>
          </thead>
          <tbody>
          <% if (documentos.length === 0) { %>
            <tr><td colspan="10" class="text-center text-gris" style="padding:30px">No hay correspondencia registrada</td></tr>
          <% } %>
          <% documentos.forEach(d => { %>
            <tr>
              <td><strong><%= d.folio_externo || '—' %></strong></td>
              <td><span class="badge badge-<%= TIPO_ENT_CLASS[d.tipo] || 'otro' %>"><%= TIPO_ENT_LABEL[d.tipo] || d.tipo %></span></td>
              <td><%= fmtFecha(d.fecha_recepcion) %></td>
              <td class="truncate"><%= d.remitente_nombre %></td>
              <td class="truncate text-sm text-gris"><%= d.remitente_institucion %></td>
              <td class="truncate"><%= d.asunto %></td>
              <td class="text-sm text-gris"><%= d.area_nombre || '—' %></td>
              <td><span class="badge badge-<%= d.estatus %>"><%= d.estatus.replace('_',' ') %></span></td>
              <td class="text-center">
                <% if (d.respondido_folio) { %>
                  <span class="badge badge-atendido" title="Respondido con <%= d.respondido_folio %>">✓</span>
                <% } else if (d.requiere_respuesta) { %>
                  <span class="badge badge-urgente" title="Requiere respuesta">!</span>
                <% } else { %>—<% } %>
              </td>
              <td><a href="/correspondencia/entrante/<%= d.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>

      <% if (paginacion.pages > 1) { %>
      <div class="pagination mt-16">
        <% if (paginacion.page > 1) { %>
          <a href="?page=<%= paginacion.page-1 %>&buscar=<%= filtros.buscar||'' %>&tipo=<%= filtros.tipo||'' %>&estatus=<%= filtros.estatus||'' %>">‹</a>
        <% } %>
        <% for(let i=1; i<=paginacion.pages; i++) { %>
          <a href="?page=<%= i %>&buscar=<%= filtros.buscar||'' %>&tipo=<%= filtros.tipo||'' %>&estatus=<%= filtros.estatus||'' %>"
             class="<%= i === paginacion.page ? 'activo' : '' %>"><%= i %></a>
        <% } %>
        <% if (paginacion.page < paginacion.pages) { %>
          <a href="?page=<%= paginacion.page+1 %>&buscar=<%= filtros.buscar||'' %>&tipo=<%= filtros.tipo||'' %>&estatus=<%= filtros.estatus||'' %>">›</a>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</div>
<script src="/js/app.js"></script>
</body></html>
