<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<%- include('../layout/sidebar') %>
<div class="main-wrapper">
  <div class="topbar">
    <h1><%= titulo %></h1>
    <div class="topbar-user">
      <span><%= usuario.nombre %></span>
      <a href="/logout">Cerrar sesión</a>
    </div>
  </div>
  <div class="page-content">

    <div class="flex items-center mb-16" style="gap:12px">
      <a href="/correspondencia/salientes" class="btn btn-secondary">← Regresar</a>
      <div class="flex gap-8">
        <a href="/correspondencia/salientes/nuevo?tipo=oficio"
           class="btn <%= tipo==='oficio'?'btn-primary':'btn-secondary' %>">Oficio</a>
        <a href="/correspondencia/salientes/nuevo?tipo=memorandum"
           class="btn <%= tipo==='memorandum'?'btn-primary':'btn-secondary' %>">Memorándum</a>
      </div>
    </div>

    <div class="card">
      <form method="POST" action="<%= accion %>">
        <input type="hidden" name="tipo" value="<%= tipo %>">

        <div style="background:var(--verde-fondo);border:1px solid var(--borde);border-radius:6px;padding:12px 16px;margin-bottom:20px">
          <strong>Folio asignado:</strong>
          <span style="font-size:18px;font-weight:700;color:var(--verde);margin-left:8px"><%= folio.numero_folio %></span>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label>Fecha de emisión *</label>
            <input type="date" name="fecha_emision" required
                   value="<%= new Date().toISOString().split('T')[0] %>">
          </div>
          <div class="form-group">
            <label>Área emisora</label>
            <select name="area_emisora_id">
              <option value="">— Seleccionar área —</option>
              <% areas.forEach(a => { %>
                <option value="<%= a.id %>"
                  <%= usuario.area_id == a.id ? 'selected' : '' %>><%= a.nombre %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group form-full">
            <label>Asunto *</label>
            <input type="text" name="asunto" required placeholder="Descripción breve del asunto">
          </div>

          <div class="form-group">
            <label>Destinatario *</label>
            <input type="text" name="destinatario" required
                   placeholder="<%= tipo==='memorandum' ? 'Nombre completo' : 'Nombre del funcionario o institución' %>">
          </div>
          <div class="form-group">
            <label>Cargo del destinatario</label>
            <input type="text" name="cargo_destinatario" placeholder="Ej. Director de Área">
          </div>

          <% if (tipo === 'oficio') { %>
          <div class="form-group form-full">
            <label>Institución destinataria</label>
            <input type="text" name="institucion_destinatario"
                   placeholder="Ej. Secretaría de Salud de Chiapas">
          </div>
          <% } %>

          <div class="form-group form-full">
            <label>Contenido / Cuerpo del documento *</label>
            <textarea name="contenido" required rows="10"
              placeholder="Redacte aquí el cuerpo del <%= tipo === 'oficio' ? 'oficio' : 'memorándum' %>..."></textarea>
          </div>
        </div>

        <div class="flex gap-8 mt-16">
          <button type="submit" class="btn btn-primary">Guardar y generar PDF</button>
          <a href="/correspondencia/salientes" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>
<script src="/js/app.js"></script>
</body></html>
