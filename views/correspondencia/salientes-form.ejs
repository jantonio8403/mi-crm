<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css?v=5">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jodit@3/build/jodit.min.css">
  <style>
    .jodit-container { border-color: var(--borde) !important; border-radius: 6px !important; }
    .jodit-toolbar__box { border-radius: 6px 6px 0 0 !important; background: var(--verde-fondo) !important; }
  </style>
</head>
<body>
<%- include('../layout/sidebar') %>
<div class="main-wrapper">
  <div class="topbar">
    <h1><%= titulo %></h1>
    <div class="topbar-user">
      <span><%= usuario.nombre %></span>
      <a href="/logout">Cerrar sesión</a>
    </div>
  </div>
  <div class="page-content">

    <div class="flex items-center mb-16" style="gap:12px">
      <a href="/correspondencia/salientes" class="btn btn-secondary">← Regresar</a>
      <% if (!documento) { %>
      <div class="flex gap-8">
        <% var raParam = locals.responde_a ? '&responde_a=' + locals.responde_a : ''; %>
        <a href="/correspondencia/salientes/nuevo?tipo=oficio<%= raParam %>"
           class="btn <%= tipo==='oficio'?'btn-primary':'btn-secondary' %>">Oficio</a>
        <a href="/correspondencia/salientes/nuevo?tipo=memorandum<%= raParam %>"
           class="btn <%= tipo==='memorandum'?'btn-primary':'btn-secondary' %>">Memorándum</a>
        <a href="/correspondencia/salientes/nuevo?tipo=circular<%= raParam %>"
           class="btn <%= tipo==='circular'?'btn-primary':'btn-secondary' %>">Circular</a>
      </div>
      <% } else { %>
      <span class="badge badge-<%= tipo %>" style="font-size:13px;padding:4px 14px"><%= tipo.charAt(0).toUpperCase() + tipo.slice(1) %></span>
      <% } %>
    </div>

    <div class="card">
      <form method="POST" action="<%= accion %>">
        <input type="hidden" name="tipo" value="<%= tipo %>">
        <% if (locals.responde_a) { %><input type="hidden" name="responde_a" value="<%= responde_a %>"><% } %>
        <div id="form-alert" class="alert alert-error" style="display:none;margin-bottom:16px"></div>

        <div style="background:var(--verde-fondo);border:1px solid var(--borde);border-radius:6px;padding:12px 16px;margin-bottom:20px;display:flex;align-items:center;gap:16px;flex-wrap:wrap">
          <div>
            <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--gris);margin-bottom:2px">Folio asignado</div>
            <span id="folio-preview" style="font-size:20px;font-weight:700;color:var(--verde);letter-spacing:.04em"><%= folio.numero_folio %></span>
          </div>
          <div style="font-size:11px;color:var(--gris);border-left:1px solid var(--borde);padding-left:16px">
            <% if (!documento) { %>
            El folio se genera con el área emisora seleccionada.<br>
            Formato: <strong>OFI/[CÓDIGO]/[CONSECUTIVO]/[AÑO]</strong>
            <% } else { %>
            Folio fijo — no cambia al editar el borrador.
            <% } %>
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label>Fecha de emisión *</label>
            <input type="date" name="fecha_emision" required
                   value="<%= documento ? documento.fecha_emisionStr : new Date().toISOString().split('T')[0] %>">
          </div>
          <div class="form-group">
            <label>Área emisora</label>
            <% if (areaFija) { %>
              <input type="hidden" name="area_emisora_id" value="<%= usuario.area_id %>">
              <input type="text" value="<%= areaNombre %>" readonly
                     style="background:var(--verde-fondo);color:var(--gris);cursor:default">
            <% } else { %>
              <select name="area_emisora_id" id="sel-area">
                <option value="">— Seleccionar área —</option>
                <% areas.forEach(a => { %>
                  <option value="<%= a.id %>"
                    <%= (documento ? documento.area_emisora_id : usuario.area_id) == a.id ? 'selected' : '' %>><%= a.nombre %></option>
                <% }) %>
              </select>
            <% } %>
          </div>

          <div class="form-group form-full">
            <label>Asunto *</label>
            <input type="text" name="asunto" required placeholder="Descripción breve del asunto"
                   value="<%= documento ? documento.asunto : '' %>">
          </div>

          <!-- Destinatario circular: checkboxes por grupo -->
          <% if (tipo === 'circular') { %>
          <div class="form-group form-full">
            <label>Dirigido a *</label>
            <div id="grupos-circular-wrap" style="display:flex;flex-direction:column;gap:6px;padding:12px 14px;border:1px solid var(--borde);border-radius:6px;background:#fff">
              <% var _sel = locals.gruposSeleccionados || []; %>
              <% locals.gruposCircular.forEach(function(g) { %>
              <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:13px;font-weight:400;padding:4px 6px;border-radius:4px;transition:background .15s"
                     onmouseover="this.style.background='var(--verde-fondo)'" onmouseout="this.style.background=''">
                <input type="checkbox" name="grupos_circular" value="<%= g %>"
                       class="grupo-circular-chk"
                       <%= _sel.includes(g) ? 'checked' : '' %>
                       style="width:15px;height:15px;accent-color:var(--verde);cursor:pointer">
                <span><%= g %></span>
              </label>
              <% }) %>
            </div>
            <div id="preview-destinatario" style="margin-top:8px;padding:10px 14px;background:var(--verde-fondo);border:1px solid var(--borde);border-radius:6px;font-size:12px;color:var(--gris);line-height:1.5">
              <span style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:4px">Vista previa del destinatario</span>
              <span id="preview-texto" style="color:var(--texto)"></span>
            </div>
          </div>
          <% } else { %>
          <div class="form-full" style="display:grid;grid-template-columns:2fr 1fr;gap:16px;align-items:start">
            <div class="form-group">
              <label>Destinatario *
                <% if (tipo === 'memorandum') { %>
                  <span style="font-weight:400;font-size:11px;color:var(--azul)"> — solo funcionarios internos</span>
                <% } else { %>
                  <span style="font-weight:400;font-size:11px;color:var(--gris)"> — solo externos</span>
                <% } %>
              </label>
              <div style="position:relative">
                <input type="text" name="destinatario" id="inp-destinatario" required autocomplete="off"
                       value="<%= documento ? documento.destinatario : '' %>"
                       data-db-selected="<%= documento && documento.destinatario ? '1' : '' %>"
                       placeholder="<%= tipo === 'memorandum' ? 'Buscar personal interno...' : 'Buscar en directorio externo...' %>">
                <div id="dir-dropdown" class="dir-dropdown" style="display:none"></div>
              </div>
            </div>
            <div class="form-group">
              <label>Cargo del destinatario</label>
              <input type="text" name="cargo_destinatario" id="inp-cargo-dest" readonly
                     value="<%= documento ? (documento.cargo_destinatario || '') : '' %>"
                     placeholder="Se llena al seleccionar"
                     style="background:var(--verde-fondo);color:var(--gris);cursor:default">
            </div>
          </div>
          <% } %>

          <!-- Con atención a + Cargo (misma fila, solo oficio) -->
          <% if (tipo === 'oficio') { %>
          <div class="form-full" style="display:grid;grid-template-columns:2fr 1fr;gap:16px;align-items:start">
            <div class="form-group">
              <label>Con atención a
                <span style="font-weight:400;font-size:11px;color:var(--gris)"> — funcionario externo (opcional)</span>
              </label>
              <div style="position:relative">
                <input type="text" name="atencion_a" id="inp-atencion-a" autocomplete="off"
                       value="<%= documento ? (documento.atencion_a || '') : '' %>"
                       data-db-selected="<%= documento && documento.atencion_a ? '1' : '' %>"
                       placeholder="Buscar en directorio externo...">
                <div id="drop-atencion-a" class="dir-dropdown" style="display:none"></div>
              </div>
            </div>
            <div class="form-group">
              <label>Cargo</label>
              <input type="text" name="atencion_a_cargo" id="inp-atencion-a-cargo" readonly
                     value="<%= documento ? (documento.atencion_a_cargo || '') : '' %>"
                     placeholder="Se llena al seleccionar"
                     style="background:var(--verde-fondo);color:var(--gris);cursor:default">
            </div>
          </div>
          <% } %>

          <div class="form-group form-full">
            <label>Contenido / Cuerpo del documento *</label>
            <textarea name="contenido" id="editor-contenido"><%- documento ? documento.contenido : '' %></textarea>
          </div>

          <hr style="grid-column:1/-1;border:none;border-top:1px solid var(--borde)">
          <div style="grid-column:1/-1;font-size:12px;font-weight:700;text-transform:uppercase;color:var(--gris);letter-spacing:.05em">
            Firmante del documento
          </div>

          <% var _director = locals.director || null; %>
          <% if (areaFija && (firmante || _director)) { %>
          <div class="form-full" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:4px">
            <% if (firmante) { %>
            <button type="button" id="btn-firma-yo" class="btn btn-secondary btn-sm"
              data-nombre="<%= firmante.nombre %>" data-cargo="<%= firmante.cargo || '' %>"
              style="font-size:12px">
              👤 Mi nombre — <em style="font-weight:400"><%= firmante.nombre %></em>
            </button>
            <% } %>
            <% if (_director) { %>
            <button type="button" id="btn-firma-dir" class="btn btn-secondary btn-sm"
              data-nombre="<%= _director.nombre %>" data-cargo="<%= _director.cargo || '' %>"
              style="font-size:12px">
              🏛 Dirección — <em style="font-weight:400"><%= _director.nombre %></em>
            </button>
            <% } %>
          </div>
          <% } %>

          <div class="form-group">
            <label>Nombre del firmante *
              <span style="font-weight:400;font-size:11px;color:var(--gris)"> — funcionario interno</span>
            </label>
            <div style="position:relative">
              <input type="text" name="firmante_nombre" id="inp-firmante" required autocomplete="off"
                     value="<%= documento ? (documento.firmante_nombre || '') : (firmante ? firmante.nombre : '') %>"
                     data-db-selected="<%= (documento && documento.firmante_nombre) || (!documento && firmante) ? '1' : '' %>"
                     placeholder="Buscar funcionario interno...">
              <div id="drop-firmante" class="dir-dropdown" style="display:none"></div>
            </div>
          </div>
          <div class="form-group">
            <label>Cargo del firmante</label>
            <input type="text" name="firmante_cargo" id="inp-firmante-cargo" readonly
                   value="<%= documento ? (documento.firmante_cargo || '') : (firmante ? (firmante.cargo || '') : '') %>"
                   placeholder="Se llena al seleccionar"
                   style="background:var(--verde-fondo);color:var(--gris);cursor:default">
          </div>

          <!-- Vo. Bo. + Elaboró -->
          <hr style="grid-column:1/-1;border:none;border-top:1px solid var(--borde)">
          <div style="grid-column:1/-1;font-size:12px;font-weight:700;text-transform:uppercase;color:var(--gris);letter-spacing:.05em">
            Vo. Bo. y Elaboró
          </div>

          <div class="form-group">
            <label>Vo. Bo.
              <span style="font-weight:400;font-size:11px;color:var(--gris)"> — interno (opcional)</span>
            </label>
            <div style="position:relative">
              <input type="text" name="vobo_nombre" id="inp-vobo" autocomplete="off"
                     value="<%= documento ? (documento.vobo_nombre || '') : '' %>"
                     data-db-selected="<%= documento && documento.vobo_nombre ? '1' : '' %>"
                     placeholder="Buscar funcionario interno...">
              <div id="drop-vobo" class="dir-dropdown" style="display:none"></div>
            </div>
          </div>
          <div class="form-group">
            <label>Cargo Vo. Bo.</label>
            <input type="text" name="vobo_cargo" id="inp-vobo-cargo" readonly
                   value="<%= documento ? (documento.vobo_cargo || '') : '' %>"
                   placeholder="Se llena al seleccionar"
                   style="background:var(--verde-fondo);color:var(--gris);cursor:default">
          </div>

          <div class="form-group form-full">
            <label>Elaboró</label>
            <% if (firmante) { %>
              <input type="hidden" name="elaboro_nombre" value="<%= firmante.nombre %>">
              <input type="hidden" name="elaboro_cargo"  value="<%= firmante.cargo || '' %>">
              <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--verde-fondo);border:1px solid var(--borde);border-radius:6px">
                <span style="font-size:18px;color:var(--verde)">✓</span>
                <div>
                  <span style="font-weight:600"><%= firmante.nombre %></span>
                  <% if (firmante.cargo) { %><span class="text-gris text-sm"> — <%= firmante.cargo %></span><% } %>
                  <div style="font-size:11px;color:var(--gris);margin-top:2px">Establecido automáticamente desde tu cuenta</div>
                </div>
              </div>
            <% } else { %>
              <input type="hidden" name="elaboro_nombre" value="">
              <input type="hidden" name="elaboro_cargo"  value="">
              <div style="padding:10px 14px;background:#f9f9f9;border:1px dashed var(--borde);border-radius:6px;font-size:13px;color:var(--gris)">
                Sin funcionario vinculado a tu cuenta. Ve al módulo <a href="/directorio" style="color:var(--verde)">Directorio</a> para vincularla.
              </div>
            <% } %>
          </div>

          <!-- Con copia para (solo oficio) -->
          <% if (tipo === 'oficio') { %>
          <div class="form-full" style="margin-top:8px">
            <hr style="border:none;border-top:1px solid var(--borde);margin-bottom:16px">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
              <span style="font-size:12px;font-weight:700;text-transform:uppercase;color:var(--gris);letter-spacing:.05em">Con copia para</span>
              <button type="button" id="btn-add-copia" class="btn btn-secondary btn-sm">+ Agregar copia</button>
            </div>
            <div id="lista-copias"></div>
          </div>
          <% } %>
        </div>

        <div class="flex gap-8 mt-16">
          <button type="submit" class="btn btn-primary"><%= documento ? 'Guardar cambios' : 'Guardar y generar PDF' %></button>
          <a href="/correspondencia/salientes" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/jodit@3/build/jodit.min.js"></script>
<script src="/js/app.js"></script>
<script>
/* ── Editor Jodit ────────────────────────────────────────────── */
(function () {
  var editor = Jodit.make('#editor-contenido', {
    language: 'es',
    height: 380,
    placeholder: 'Redacte aquí el cuerpo del documento...',
    buttons: [
      'bold', 'italic', 'underline', 'strikethrough', '|',
      'ul', 'ol', '|',
      'outdent', 'indent', '|',
      'font', 'fontsize', '|',
      'left', 'center', 'right', 'justify', '|',
      'table', '|',
      'undo', 'redo', '|',
      'eraser', 'fullsize'
    ],
    uploader: { insertImageAsBase64URI: false },
    showCharsCounter: false,
    showWordsCounter: false,
    showXPathInStatusbar: false
  });

  var alerta = document.getElementById('form-alert');

  document.querySelector('form').addEventListener('submit', function (e) {
    alerta.style.display = 'none';

    function mostrarError(msg, campo) {
      e.preventDefault();
      alerta.innerHTML = '<strong>✕ Campo incompleto:</strong> ' + msg;
      alerta.style.display = 'block';
      alerta.scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (campo) {
        campo.style.borderColor = 'var(--rojo)';
        setTimeout(function () { campo.focus(); }, 200);
      }
    }

    // Validar fecha
    var fecha = document.querySelector('[name="fecha_emision"]');
    if (fecha && !fecha.value.trim()) {
      mostrarError('La <strong>Fecha de emisión</strong> es obligatoria.', fecha);
      return;
    }

    // Validar asunto
    var asunto = document.querySelector('[name="asunto"]');
    if (asunto && !asunto.value.trim()) {
      mostrarError('El campo <strong>Asunto</strong> es obligatorio.', asunto);
      return;
    }

    // Validar contenido del editor
    var contenido = editor.value || '';
    if (contenido.replace(/<[^>]*>/g, '').trim() === '') {
      e.preventDefault();
      alerta.innerHTML = '<strong>✕ Campo incompleto:</strong> El <strong>Contenido</strong> del documento es obligatorio. Redacte el cuerpo antes de guardar.';
      alerta.style.display = 'block';
      alerta.scrollIntoView({ behavior: 'smooth', block: 'center' });
      editor.container.style.borderColor = 'var(--rojo)';
      editor.focus();
      return;
    }

    // Validar campos que deben venir del directorio
    var esCircular = '<%= tipo %>' === 'circular';

    // Circular: al menos un grupo seleccionado
    if (esCircular) {
      var chksGrupos = document.querySelectorAll('.grupo-circular-chk:checked');
      if (chksGrupos.length === 0) {
        mostrarError('Selecciona al menos un <strong>grupo destinatario</strong> para la circular.');
        return;
      }
    }

    var camposDir = [
      { id: 'inp-destinatario', label: 'Destinatario', opcional: esCircular },
      { id: 'inp-atencion-a',   label: 'Con atención a', opcional: true },
      { id: 'inp-firmante',     label: 'Firmante',     opcional: false },
      { id: 'inp-vobo',         label: 'Vo. Bo.',       opcional: true },
    ];
    for (var i = 0; i < camposDir.length; i++) {
      var cd = camposDir[i];
      var el = document.getElementById(cd.id);
      if (!el) continue;
      if (!cd.opcional && !el.value.trim()) {
        mostrarError('El campo <strong>' + cd.label + '</strong> es obligatorio.', el);
        return;
      }
      if (cd.opcional && !el.value.trim()) continue;
      if (el.value.trim() && !el.dataset.dbSelected) {
        mostrarError('El campo <strong>' + cd.label + '</strong> debe seleccionarse del directorio. Use el buscador y seleccione una opción de la lista.', el);
        return;
      }
    }

    // Validar copias (solo oficio)
    var copiaFilas = document.querySelectorAll('.copia-fila');
    for (var j = 0; j < copiaFilas.length; j++) {
      var nombreInp = copiaFilas[j].querySelector('.copia-nombre');
      if (nombreInp && nombreInp.value.trim() && !nombreInp.dataset.dbSelected) {
        mostrarError('Una entrada de <strong>Con copia para</strong> no fue seleccionada del directorio. Use el buscador.', nombreInp);
        return;
      }
    }
  });
}());
</script>
<script>
/* Autocomplete destinatario — directorio de funcionarios */
(function () {
  var inp   = document.getElementById('inp-destinatario');
  var drop  = document.getElementById('dir-dropdown');
  var cargo = document.getElementById('inp-cargo-dest');

  if (!inp || !drop) return;

  var timer = null;
  var ultima = '';

  function esc(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function ocultar() {
    drop.style.display = 'none';
  }

  function mostrar(lista) {
    drop.innerHTML = '';
    if (!lista || lista.length === 0) {
      drop.innerHTML = '<div class="dir-no-results">Sin resultados. Agrega funcionarios en el Directorio.</div>';
      drop.style.display = 'block';
      return;
    }
    lista.forEach(function (f) {
      var esInt  = f.tipo === 'interno';
      var org    = esInt ? (f.area_nombre || '') : (f.institucion || '');
      var linea2 = [f.cargo, org].filter(Boolean).join(' · ');
      var el = document.createElement('div');
      el.className = 'dir-item';
      el.innerHTML =
        '<div class="dir-item-tipo ' + (esInt ? 'int' : 'ext') + '">' + (esInt ? 'I' : 'E') + '</div>' +
        '<div class="dir-item-info">' +
          '<div class="dir-item-nombre">' + esc(f.nombre) + '</div>' +
          '<div class="dir-item-sub">'   + esc(linea2 || '—') + '</div>' +
        '</div>';
      el.addEventListener('mousedown', function (e) {
        e.preventDefault();
        inp.value = f.nombre;
        inp.dataset.dbSelected = '1';
        inp.style.borderColor = '';
        if (cargo) cargo.value = f.cargo || '';
        ocultar();
      });
      drop.appendChild(el);
    });
    drop.style.display = 'block';
  }

  function buscar(q) {
    q = (q || '').trim();
    if (!q) { ocultar(); return; }
    ultima = q;
    /* indicador visual */
    drop.innerHTML = '<div class="dir-no-results">Buscando...</div>';
    drop.style.display = 'block';

    var filtroTipo = '<%= tipo %>' === 'memorandum' ? '&tipo=interno' : '&tipo=externo';
    fetch('/directorio/buscar?q=' + encodeURIComponent(q) + filtroTipo, {
      credentials: 'include',
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    })
    .then(function (data) {
      if (ultima === q) mostrar(data);
    })
    .catch(function (err) {
      console.error('Error autocomplete:', err);
      drop.innerHTML = '<div class="dir-no-results" style="color:var(--rojo)">Error al buscar. Revisa la consola.</div>';
      drop.style.display = 'block';
    });
  }

  inp.addEventListener('input', function () {
    delete inp.dataset.dbSelected;
    if (cargo) cargo.value = '';
    clearTimeout(timer);
    timer = setTimeout(function () { buscar(inp.value); }, 280);
  });

  inp.addEventListener('focus', function () {
    if (inp.value.trim()) buscar(inp.value);
  });

  document.addEventListener('click', function (e) {
    if (!inp.contains(e.target) && !drop.contains(e.target)) ocultar();
  });
}());

<% if (tipo === 'oficio') { %>
/* Autocomplete "Con atención a" — solo funcionarios externos */
(function () {
  var inp   = document.getElementById('inp-atencion-a');
  var drop  = document.getElementById('drop-atencion-a');
  var cargo = document.getElementById('inp-atencion-a-cargo');
  if (!inp || !drop) return;

  var timer = null;
  var ultima = '';

  function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function ocultar() { drop.style.display = 'none'; }

  function mostrar(lista) {
    drop.innerHTML = '';
    if (!lista || lista.length === 0) {
