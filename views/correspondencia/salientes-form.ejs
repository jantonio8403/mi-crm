<script>
/* Presets firmante (jefe_area) */
(function () {
  var inpNombre = document.getElementById('inp-firmante');
  var inpCargo  = document.getElementById('inp-firmante-cargo');
  if (!inpNombre) return;

  function aplicarPreset(btn) {
    inpNombre.value = btn.dataset.nombre || '';
    if (inpCargo) inpCargo.value = btn.dataset.cargo || '';
    inpNombre.dataset.dbSelected = '1';
    inpNombre.style.borderColor = '';
    // Resaltar botón activo
    document.querySelectorAll('#btn-firma-yo, #btn-firma-dir').forEach(function (b) {
      b.style.borderColor = '';
      b.style.background  = '';
      b.style.color       = '';
    });
    btn.style.borderColor = 'var(--verde)';
    btn.style.background  = 'var(--verde-fondo)';
    btn.style.color       = 'var(--verde)';
  }

  ['btn-firma-yo', 'btn-firma-dir'].forEach(function (id) {
    var btn = document.getElementById(id);
    if (btn) btn.addEventListener('click', function () { aplicarPreset(btn); });
  });

  // Marcar activo el que coincide con el valor actual al cargar
  var valorActual = inpNombre.value.trim();
  if (valorActual) {
    ['btn-firma-yo', 'btn-firma-dir'].forEach(function (id) {
      var btn = document.getElementById(id);
      if (btn && btn.dataset.nombre === valorActual) aplicarPreset(btn);
    });
  }
}());
</script>
<script>
/* Actualizar folio al cambiar área emisora */
(function () {
  var sel       = document.getElementById('sel-area');
  var folioSpan = document.getElementById('folio-preview');
  if (!sel || !folioSpan) return;
  sel.addEventListener('change', function () {
    var areaId = sel.value || '';
    var tipo   = '<%= tipo %>';
    fetch('/correspondencia/salientes/folio?tipo=' + tipo + (areaId ? '&area_id=' + areaId : ''), {
      credentials: 'include',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function (r) { return r.json(); })
    .then(function (d) { if (d.numero_folio) folioSpan.textContent = d.numero_folio; })
    .catch(function () {});
  });
}());
</script>
<% if (tipo === 'circular') { %>
<script>
/* Vista previa destinatario circular */
(function () {
  var GRUPOS = <%- JSON.stringify(locals.gruposCircular || []) %>;
  var SUFIJO = 'que laboran y/o prestan servicio en esta unidad médica';
  var previewEl = document.getElementById('preview-texto');
  var wrap = document.getElementById('grupos-circular-wrap');
  if (!previewEl || !wrap) return;

  function actualizar() {
    var chks = wrap.querySelectorAll('.grupo-circular-chk:checked');
    var seleccionados = Array.prototype.map.call(chks, function (c) { return c.value; });
    var ordenados = GRUPOS.filter(function (g) { return seleccionados.indexOf(g) !== -1; });
    if (ordenados.length === 0) {
      previewEl.innerHTML = '<em style="color:var(--gris)">Selecciona al menos un grupo</em>';
    } else {
      previewEl.textContent = ordenados.join(', ') + ' ' + SUFIJO;
    }
  }

  wrap.querySelectorAll('.grupo-circular-chk').forEach(function (chk) {
    chk.addEventListener('change', actualizar);
  });

  actualizar(); // inicializar al cargar
}());
</script>
<% } %>
<% if (tipo === 'oficio') { %>
<script>
/* Copias dinámicas (C.c.p.) */
(function () {
  var lista  = document.getElementById('lista-copias');
  var btnAdd = document.getElementById('btn-add-copia');
  if (!lista || !btnAdd) return;
  var contador = 0;

  function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function attachAutocomplete(fila) {
    var inp   = fila.querySelector('.copia-nombre');
    var drop  = fila.querySelector('.copia-drop');
    var cargo = fila.querySelector('.copia-cargo');
    var timer = null, ultima = '';

    function ocultar() { drop.style.display = 'none'; }

    function mostrar(lista_res) {
      drop.innerHTML = '';
      if (!lista_res || lista_res.length === 0) {
        drop.innerHTML = '<div class="dir-no-results">Sin resultados en el directorio.</div>';
        drop.style.display = 'block';
        return;
      }
      lista_res.forEach(function (f) {
        var esInt  = f.tipo === 'interno';
        var linea2 = [f.cargo, esInt ? f.area_nombre : f.institucion].filter(Boolean).join(' · ');
        var el = document.createElement('div');
        el.className = 'dir-item';
        el.innerHTML =
          '<div class="dir-item-tipo ' + (esInt ? 'int' : 'ext') + '">' + (esInt ? 'I' : 'E') + '</div>' +
          '<div class="dir-item-info">' +
            '<div class="dir-item-nombre">' + esc(f.nombre) + '</div>' +
            '<div class="dir-item-sub">'   + esc(linea2 || '—') + '</div>' +
          '</div>';
        el.addEventListener('mousedown', function (e) {
          e.preventDefault();
          inp.value = f.nombre;
          inp.dataset.dbSelected = '1';
          inp.style.borderColor = '';
          if (cargo) cargo.value = f.cargo || '';
          ocultar();
        });
        drop.appendChild(el);
      });
      drop.style.display = 'block';
    }

    function buscar(q) {
      q = (q||'').trim();
      if (!q) { ocultar(); return; }
      ultima = q;
      drop.innerHTML = '<div class="dir-no-results">Buscando...</div>';
      drop.style.display = 'block';
      fetch('/directorio/buscar?q=' + encodeURIComponent(q) + '&tipo=externo', {
        credentials: 'include',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
      })
      .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
      .then(function (data) { if (ultima === q) mostrar(data); })
      .catch(function () {
        drop.innerHTML = '<div class="dir-no-results" style="color:var(--rojo)">Error al buscar.</div>';
        drop.style.display = 'block';
      });
    }

    inp.addEventListener('input', function () {
      delete inp.dataset.dbSelected;
      if (cargo) cargo.value = '';
      clearTimeout(timer);
      timer = setTimeout(function () { buscar(inp.value); }, 280);
    });
    inp.addEventListener('focus', function () { if (inp.value.trim()) buscar(inp.value); });
    document.addEventListener('click', function (e) {
      if (!inp.contains(e.target) && !drop.contains(e.target)) ocultar();
    });
  }

  function agregarFila(preNombre, preCargo) {
    var idx = contador++;
    var div = document.createElement('div');
    div.className = 'copia-fila';
    div.style.cssText = 'display:grid;grid-template-columns:2fr 1fr auto;gap:8px;align-items:center;margin-bottom:8px';
    div.innerHTML =
      '<div style="position:relative">' +
        '<input type="text" name="copias[' + idx + '][nombre]" class="copia-nombre" autocomplete="off" placeholder="Buscar en directorio...">' +
        '<div class="dir-dropdown copia-drop" style="display:none"></div>' +
      '</div>' +
      '<input type="text" name="copias[' + idx + '][cargo]" class="copia-cargo" readonly ' +
        'placeholder="Se llena al seleccionar" style="background:var(--verde-fondo);color:var(--gris);cursor:default">' +
      '<button type="button" class="btn btn-secondary btn-sm copia-quitar" style="padding:0 10px;flex-shrink:0">✕</button>';
    lista.appendChild(div);
    attachAutocomplete(div);
    div.querySelector('.copia-quitar').addEventListener('click', function () { div.remove(); });
    if (preNombre) {
      var ni = div.querySelector('.copia-nombre');
      ni.value = preNombre;
      ni.dataset.dbSelected = '1';
      var ci = div.querySelector('.copia-cargo');
      if (ci && preCargo) ci.value = preCargo;
    } else {
      div.querySelector('.copia-nombre').focus();
    }
  }

  btnAdd.addEventListener('click', function () { agregarFila(); });

  // Pre-llenar copias en modo edición
  var copiasIniciales = <%- JSON.stringify(locals.copias || []) %>;
  copiasIniciales.forEach(function (c) { agregarFila(c.nombre, c.cargo || ''); });
}());
</script>
<% } %>
