<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="stylesheet" href="/css/app.css">
  <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
  <link href="https://unpkg.com/quill-better-table@1.2.10/dist/quill-better-table.css" rel="stylesheet">
  <style>
    .ql-container { font-family: inherit; font-size: 13px; }
    .ql-editor    { min-height: 220px; line-height: 1.7; }
    .ql-toolbar.ql-snow { border-color: var(--borde); border-radius: 6px 6px 0 0; background: var(--verde-fondo); }
    .ql-container.ql-snow { border-color: var(--borde); border-radius: 0 0 6px 6px; background: #fff; }
    .ql-editor.ql-blank::before { color: var(--gris); font-style: normal; }
    .ql-table-btn::before { content: '⊞'; font-size: 15px; line-height: 1; }
  </style>
</head>
<body>
<%- include('../layout/sidebar') %>
<div class="main-wrapper">
  <div class="topbar">
    <h1><%= titulo %></h1>
    <div class="topbar-user">
      <span><%= usuario.nombre %></span>
      <a href="/logout">Cerrar sesión</a>
    </div>
  </div>
  <div class="page-content">

    <div class="flex items-center mb-16" style="gap:12px">
      <a href="/correspondencia/salientes" class="btn btn-secondary">← Regresar</a>
      <div class="flex gap-8">
        <a href="/correspondencia/salientes/nuevo?tipo=oficio"
           class="btn <%= tipo==='oficio'?'btn-primary':'btn-secondary' %>">Oficio</a>
        <a href="/correspondencia/salientes/nuevo?tipo=memorandum"
           class="btn <%= tipo==='memorandum'?'btn-primary':'btn-secondary' %>">Memorándum</a>
      </div>
    </div>

    <div class="card">
      <form method="POST" action="<%= accion %>">
        <input type="hidden" name="tipo" value="<%= tipo %>">

        <div style="background:var(--verde-fondo);border:1px solid var(--borde);border-radius:6px;padding:12px 16px;margin-bottom:20px;display:flex;align-items:center;gap:16px;flex-wrap:wrap">
          <div>
            <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--gris);margin-bottom:2px">Folio asignado</div>
            <span style="font-size:20px;font-weight:700;color:var(--verde);letter-spacing:.04em"><%= folio.numero_folio %></span>
          </div>
          <div style="font-size:11px;color:var(--gris);border-left:1px solid var(--borde);padding-left:16px">
            El folio se genera con el área emisora seleccionada.<br>
            Formato: <strong>OFI/[CÓDIGO]/[CONSECUTIVO]/[AÑO]</strong>
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label>Fecha de emisión *</label>
            <input type="date" name="fecha_emision" required
                   value="<%= new Date().toISOString().split('T')[0] %>">
          </div>
          <div class="form-group">
            <label>Área emisora</label>
            <select name="area_emisora_id">
              <option value="">— Seleccionar área —</option>
              <% areas.forEach(a => { %>
                <option value="<%= a.id %>"
                  <%= usuario.area_id == a.id ? 'selected' : '' %>><%= a.nombre %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group form-full">
            <label>Asunto *</label>
            <input type="text" name="asunto" required placeholder="Descripción breve del asunto">
          </div>

          <!-- Destinatario + Cargo (misma fila) -->
          <div class="form-full" style="display:grid;grid-template-columns:2fr 1fr;gap:16px;align-items:start">
            <div class="form-group">
              <label>Destinatario *
                <% if (tipo === 'memorandum') { %>
                  <span style="font-weight:400;font-size:11px;color:var(--azul)"> — solo funcionarios internos</span>
                <% } else { %>
                  <span style="font-weight:400;font-size:11px;color:var(--gris)"> — solo externos</span>
                <% } %>
              </label>
              <div style="position:relative">
                <input type="text" name="destinatario" id="inp-destinatario" required autocomplete="off"
                       placeholder="<%= tipo === 'memorandum' ? 'Buscar personal interno...' : 'Buscar en directorio externo...' %>">
                <div id="dir-dropdown" class="dir-dropdown" style="display:none"></div>
              </div>
            </div>
            <div class="form-group">
              <label>Cargo del destinatario</label>
              <input type="text" name="cargo_destinatario" id="inp-cargo-dest" readonly
                     placeholder="Se llena al seleccionar"
                     style="background:var(--verde-fondo);color:var(--gris);cursor:default">
            </div>
          </div>

          <!-- Con atención a + Cargo (misma fila, solo oficio) -->
          <% if (tipo === 'oficio') { %>
          <div class="form-full" style="display:grid;grid-template-columns:2fr 1fr;gap:16px;align-items:start">
            <div class="form-group">
              <label>Con atención a
                <span style="font-weight:400;font-size:11px;color:var(--gris)"> — funcionario externo (opcional)</span>
              </label>
              <div style="position:relative">
                <input type="text" name="atencion_a" id="inp-atencion-a" autocomplete="off"
                       placeholder="Buscar en directorio externo...">
                <div id="drop-atencion-a" class="dir-dropdown" style="display:none"></div>
              </div>
            </div>
            <div class="form-group">
              <label>Cargo</label>
              <input type="text" name="atencion_a_cargo" id="inp-atencion-a-cargo" readonly
                     placeholder="Se llena al seleccionar"
                     style="background:var(--verde-fondo);color:var(--gris);cursor:default">
            </div>
          </div>
          <% } %>

          <div class="form-group form-full">
            <label>Contenido / Cuerpo del documento *</label>
            <textarea name="contenido" id="contenido-hidden" style="display:none"></textarea>
            <div id="quill-editor"></div>
          </div>

          <hr style="grid-column:1/-1;border:none;border-top:1px solid var(--borde)">
          <div style="grid-column:1/-1;font-size:12px;font-weight:700;text-transform:uppercase;color:var(--gris);letter-spacing:.05em">
            Firmante del documento
          </div>

          <div class="form-group">
            <label>Nombre del firmante *
              <% if (firmante) { %><span style="font-weight:400;font-size:11px;color:var(--verde)"> — tomado del directorio interno</span><% } %>
            </label>
            <input type="text" name="firmante_nombre" required
                   value="<%= firmante ? firmante.nombre : usuario.nombre %>"
                   placeholder="Nombre completo del firmante">
          </div>
          <div class="form-group">
            <label>Cargo del firmante</label>
            <input type="text" name="firmante_cargo"
                   value="<%= firmante ? (firmante.cargo || '') : (usuario.cargo || '') %>"
                   placeholder="Ej. Director del Hospital">
          </div>
        </div>

        <div class="flex gap-8 mt-16">
          <button type="submit" class="btn btn-primary">Guardar y generar PDF</button>
          <a href="/correspondencia/salientes" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script src="https://unpkg.com/quill-better-table@1.2.10/dist/quill-better-table.js"></script>
<script src="/js/app.js"></script>
<script>
/* ── Editor de texto (Quill + tablas) ────────────────────────── */
(function () {
  var BetterTable = window.quillBetterTable || window.QuillBetterTable;

  if (BetterTable) {
    Quill.register({ 'modules/better-table': BetterTable }, true);
  }

  var modulos = {
    toolbar: [
      [{ header: [1, 2, 3, false] }],
      ['bold', 'italic', 'underline'],
      [{ list: 'ordered' }, { list: 'bullet' }],
      [{ align: [] }],
      [{ indent: '-1' }, { indent: '+1' }],
      ['clean']
    ],
    table: false
  };

  if (BetterTable) {
    modulos['better-table'] = {
      operationMenu: { items: { unmergeCells: { text: 'Separar celdas' } } }
    };
    modulos.keyboard = { bindings: BetterTable.keyboardBindings };
  }

  var quill = new Quill('#quill-editor', {
    theme: 'snow',
    placeholder: 'Redacte aquí el cuerpo del documento...',
    modules: modulos
  });

  /* Botón "Insertar tabla" inyectado directamente en la toolbar */
  if (BetterTable) {
    var toolbar = document.querySelector('.ql-toolbar');
    var span = document.createElement('span');
    span.className = 'ql-formats';
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.title = 'Insertar tabla';
    btn.style.cssText = 'width:auto;padding:2px 8px;font-size:12px;font-weight:600';
    btn.textContent = '⊞ Tabla';
    btn.addEventListener('mousedown', function (e) {
      e.preventDefault();
      quill.getModule('better-table').insertTable(3, 3);
    });
    span.appendChild(btn);
    toolbar.appendChild(span);
  }

  var form   = document.querySelector('form');
  var hidden = document.getElementById('contenido-hidden');

  form.addEventListener('submit', function (e) {
    if (quill.getText().trim() === '') {
      e.preventDefault();
      quill.root.style.borderColor = 'var(--rojo)';
      quill.focus();
      return;
    }
    hidden.value = quill.root.innerHTML;
  });
}());
</script>
<script>
/* Autocomplete destinatario — directorio de funcionarios */
(function () {
  var inp    = document.getElementById('inp-destinatario');
  var drop   = document.getElementById('dir-dropdown');
  var cargo  = document.getElementById('inp-cargo-dest');
  var inst   = document.getElementById('inp-institucion-dest');

  if (!inp || !drop) {
    console.error('Autocomplete: no se encontraron los elementos del DOM');
    return;
  }

  var timer = null;
  var ultima = '';

  function esc(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function ocultar() {
    drop.style.display = 'none';
  }

  function mostrar(lista) {
    drop.innerHTML = '';
    if (!lista || lista.length === 0) {
      drop.innerHTML = '<div class="dir-no-results">Sin resultados. Agrega funcionarios en el Directorio.</div>';
      drop.style.display = 'block';
      return;
    }
    lista.forEach(function (f) {
      var esInt  = f.tipo === 'interno';
      var org    = esInt ? (f.area_nombre || '') : (f.institucion || '');
      var linea2 = [f.cargo, org].filter(Boolean).join(' · ');
      var el = document.createElement('div');
      el.className = 'dir-item';
      el.innerHTML =
        '<div class="dir-item-tipo ' + (esInt ? 'int' : 'ext') + '">' + (esInt ? 'I' : 'E') + '</div>' +
        '<div class="dir-item-info">' +
          '<div class="dir-item-nombre">' + esc(f.nombre) + '</div>' +
          '<div class="dir-item-sub">'   + esc(linea2 || '—') + '</div>' +
        '</div>';
      el.addEventListener('mousedown', function (e) {
        e.preventDefault();
        inp.value   = f.nombre;
        if (cargo) cargo.value = f.cargo || '';
        if (inst)  inst.value  = esInt ? (f.area_nombre || '') : (f.institucion || '');
        ocultar();
      });
      drop.appendChild(el);
    });
    drop.style.display = 'block';
  }

  function buscar(q) {
    q = (q || '').trim();
    if (!q) { ocultar(); return; }
    ultima = q;
    /* indicador visual */
    drop.innerHTML = '<div class="dir-no-results">Buscando...</div>';
    drop.style.display = 'block';

    var filtroTipo = '<%= tipo %>' === 'memorandum' ? '&tipo=interno' : '&tipo=externo';
    fetch('/directorio/buscar?q=' + encodeURIComponent(q) + filtroTipo, {
      credentials: 'include',
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    })
    .then(function (data) {
      if (ultima === q) mostrar(data);
    })
    .catch(function (err) {
      console.error('Error autocomplete:', err);
      drop.innerHTML = '<div class="dir-no-results" style="color:var(--rojo)">Error al buscar. Revisa la consola.</div>';
      drop.style.display = 'block';
    });
  }

  inp.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () { buscar(inp.value); }, 280);
  });

  inp.addEventListener('focus', function () {
    if (inp.value.trim()) buscar(inp.value);
  });

  document.addEventListener('click', function (e) {
    if (!inp.contains(e.target) && !drop.contains(e.target)) ocultar();
  });
}());

<% if (tipo === 'oficio') { %>
/* Autocomplete "Con atención a" — solo funcionarios externos */
(function () {
  var inp   = document.getElementById('inp-atencion-a');
  var drop  = document.getElementById('drop-atencion-a');
  var cargo = document.getElementById('inp-atencion-a-cargo');
  if (!inp || !drop) return;

  var timer = null;
  var ultima = '';

  function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function ocultar() { drop.style.display = 'none'; }

  function mostrar(lista) {
    drop.innerHTML = '';
    if (!lista || lista.length === 0) {
      drop.innerHTML = '<div class="dir-no-results">Sin resultados en directorio externo.</div>';
      drop.style.display = 'block';
      return;
    }
    lista.forEach(function (f) {
      var linea2 = [f.cargo, f.institucion].filter(Boolean).join(' · ');
      var el = document.createElement('div');
      el.className = 'dir-item';
      el.innerHTML =
        '<div class="dir-item-tipo ext">E</div>' +
        '<div class="dir-item-info">' +
          '<div class="dir-item-nombre">' + esc(f.nombre) + '</div>' +
          '<div class="dir-item-sub">'   + esc(linea2 || '—') + '</div>' +
        '</div>';
      el.addEventListener('mousedown', function (e) {
        e.preventDefault();
        inp.value = f.nombre;
        if (cargo) cargo.value = f.cargo || '';
        ocultar();
      });
      drop.appendChild(el);
    });
    drop.style.display = 'block';
  }

  function buscar(q) {
    q = (q || '').trim();
    if (!q) { ocultar(); return; }
    ultima = q;
    drop.innerHTML = '<div class="dir-no-results">Buscando...</div>';
    drop.style.display = 'block';
    fetch('/directorio/buscar?q=' + encodeURIComponent(q) + '&tipo=externo', {
      credentials: 'include',
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function (data) { if (ultima === q) mostrar(data); })
    .catch(function () {
      drop.innerHTML = '<div class="dir-no-results" style="color:var(--rojo)">Error al buscar.</div>';
      drop.style.display = 'block';
    });
  }

  inp.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () { buscar(inp.value); }, 280);
  });
  inp.addEventListener('focus', function () { if (inp.value.trim()) buscar(inp.value); });
  document.addEventListener('click', function (e) {
    if (!inp.contains(e.target) && !drop.contains(e.target)) ocultar();
  });
}());
<% } %>
</script>
</body></html>
