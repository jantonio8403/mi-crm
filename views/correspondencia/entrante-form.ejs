<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css?v=12">
</head>
<body>
<%- include('../layout/sidebar') %>
<div class="main-wrapper">
  <div class="topbar">
    <h1><%= titulo %></h1>
    <div class="topbar-user">
      <span><%= usuario.nombre %></span>
    </div>
  </div>
  <div class="page-content">

    <div class="flex items-center mb-16">
      <a href="/correspondencia/entrante" class="btn btn-secondary">← Regresar</a>
    </div>

    <div class="card">
      <form method="POST" action="<%= accion %>" enctype="multipart/form-data">

        <h4 style="margin-bottom:16px;color:var(--gris);font-size:12px;text-transform:uppercase;letter-spacing:.05em">
          Datos del documento recibido
        </h4>

        <div class="form-grid">
          <div class="form-group">
            <label>Folio / Número externo</label>
            <input type="text" name="folio_externo" placeholder="Ej. OFICIO-234/2026">
          </div>
          <div class="form-group">
            <label>Tipo de documento *</label>
            <select name="tipo" required>
              <option value="oficio">Oficio</option>
              <option value="memorandum">Memorándum</option>
              <option value="circular">Circular</option>
              <option value="oficio-circular">Oficio-Circular</option>
              <option value="dictamen">Dictamen</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div class="form-group">
            <label>Fecha de recepción *</label>
            <input type="date" name="fecha_recepcion" required value="<%= hoy %>">
          </div>
          <div class="form-group">
            <label>Fecha del documento</label>
            <input type="date" name="fecha_documento">
          </div>
        </div>

        <hr style="border:none;border-top:1px solid var(--borde);margin:20px 0">
        <h4 style="margin-bottom:16px;color:var(--gris);font-size:12px;text-transform:uppercase;letter-spacing:.05em">
          Remitente
        </h4>

        <div class="form-grid">
          <div class="form-group">
            <label>Nombre del remitente *
              <span style="font-weight:400;font-size:11px;color:var(--gris)"> — busca en directorio o escribe libremente</span>
            </label>
            <div style="position:relative">
              <input type="text" name="remitente_nombre" id="inp-remitente" required
                     autocomplete="off" placeholder="Buscar o escribir nombre...">
              <div id="drop-remitente" class="dir-dropdown" style="display:none"></div>
            </div>
          </div>
          <div class="form-group">
            <label>Cargo del remitente</label>
            <input type="text" name="remitente_cargo" id="inp-remitente-cargo"
                   placeholder="Ej. Director de Salud Municipal">
          </div>
          <div class="form-group form-full">
            <label>Institución / Dependencia *</label>
            <input type="text" name="remitente_institucion" id="inp-remitente-inst" required
                   placeholder="Ej. Secretaría de Salud de Chiapas">
          </div>
        </div>

        <hr style="border:none;border-top:1px solid var(--borde);margin:20px 0">
        <h4 style="margin-bottom:16px;color:var(--gris);font-size:12px;text-transform:uppercase;letter-spacing:.05em">
          Contenido y destino
        </h4>

        <div class="form-grid">
          <div class="form-group form-full">
            <label>Asunto *</label>
            <input type="text" name="asunto" required placeholder="Asunto del documento">
          </div>
          <div class="form-group form-full">
            <label>Descripción / Resumen</label>
            <textarea name="descripcion" rows="3" placeholder="Breve descripción del contenido..."></textarea>
          </div>
          <div class="form-group">
            <label>Área destinataria</label>
            <select name="area_destinataria_id">
              <option value="">— Seleccionar área —</option>
              <% areas.forEach(a => { %>
                <option value="<%= a.id %>"><%= a.nombre %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Archivo escaneado (PDF/imagen)</label>
            <input type="file" name="archivo" accept=".pdf,.jpg,.jpeg,.png">
          </div>
        </div>

        <hr style="border:none;border-top:1px solid var(--borde);margin:20px 0">
        <h4 style="margin-bottom:16px;color:var(--gris);font-size:12px;text-transform:uppercase;letter-spacing:.05em">
          Seguimiento
        </h4>

        <div class="form-grid">
          <div class="form-group checkbox">
            <input type="checkbox" name="requiere_respuesta" id="resp" value="on">
            <label for="resp">Requiere respuesta</label>
          </div>
          <div class="form-group" id="campo-fecha-limite">
            <label>Fecha límite de respuesta</label>
            <input type="date" name="fecha_limite_respuesta">
          </div>
          <div class="form-group form-full">
            <label>Notas internas</label>
            <textarea name="notas" rows="2" placeholder="Instrucciones o notas de seguimiento..."></textarea>
          </div>
        </div>

        <div class="flex gap-8 mt-16">
          <button type="submit" class="btn btn-primary">Registrar correspondencia</button>
          <a href="/correspondencia/entrante" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>
<script src="/js/app.js?v=12"></script>
<script>
  const chk = document.getElementById('resp');
  const campo = document.getElementById('campo-fecha-limite');
  campo.style.opacity = chk.checked ? '1' : '0.4';
  chk.addEventListener('change', () => {
    campo.style.opacity = chk.checked ? '1' : '0.4';
    campo.querySelector('input').disabled = !chk.checked;
  });
  campo.querySelector('input').disabled = true;
</script>
<script>
/* Autocomplete remitente — internos y externos, selección libre */
(function () {
  var inp   = document.getElementById('inp-remitente');
  var drop  = document.getElementById('drop-remitente');
  var cargo = document.getElementById('inp-remitente-cargo');
  var inst  = document.getElementById('inp-remitente-inst');
  if (!inp || !drop) return;

  var timer = null;
  var ultima = '';

  function esc(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function ocultar() { drop.style.display = 'none'; }

  function mostrar(lista) {
    drop.innerHTML = '';
    if (!lista || lista.length === 0) {
      drop.innerHTML = '<div class="dir-no-results">Sin coincidencias — puedes escribir el nombre libremente.</div>';
      drop.style.display = 'block';
      return;
    }
    lista.forEach(function (f) {
      var esInt  = f.tipo === 'interno';
      var org    = esInt ? (f.area_nombre || 'HBC Berriozábal') : (f.institucion || '');
      var linea2 = [f.cargo, org].filter(Boolean).join(' · ');
      var el = document.createElement('div');
      el.className = 'dir-item';
      el.innerHTML =
        '<div class="dir-item-tipo ' + (esInt ? 'int' : 'ext') + '">' + (esInt ? 'I' : 'E') + '</div>' +
        '<div class="dir-item-info">' +
          '<div class="dir-item-nombre">' + esc(f.nombre) + '</div>' +
          '<div class="dir-item-sub">'   + esc(linea2 || '—') + '</div>' +
        '</div>';
      el.addEventListener('mousedown', function (ev) {
        ev.preventDefault();
        inp.value = f.nombre;
        if (cargo) cargo.value = f.cargo || '';
        if (inst)  inst.value  = esInt ? (f.area_nombre || 'HBC Berriozábal') : (f.institucion || '');
        ocultar();
      });
      drop.appendChild(el);
    });
    drop.style.display = 'block';
  }

  function buscar(q) {
    q = (q || '').trim();
    if (q.length < 2) { ocultar(); return; }
    ultima = q;
    drop.innerHTML = '<div class="dir-no-results">Buscando...</div>';
    drop.style.display = 'block';
    fetch('/directorio/buscar?q=' + encodeURIComponent(q), {
      credentials: 'include',
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function (data) { if (ultima === q) mostrar(data); })
    .catch(function () {
      drop.innerHTML = '<div class="dir-no-results" style="color:var(--rojo)">Error al buscar.</div>';
      drop.style.display = 'block';
    });
  }

  inp.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () { buscar(inp.value); }, 280);
  });

  inp.addEventListener('focus', function () {
    if (inp.value.trim().length >= 2) buscar(inp.value);
  });

  document.addEventListener('click', function (e) {
    if (!inp.contains(e.target) && !drop.contains(e.target)) ocultar();
  });
}());
</script>
</body></html>
