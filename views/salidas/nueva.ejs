<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css?v=12">
</head>
<body>
<%- include('../layout/sidebar') %>
<div class="main-wrapper">
  <div class="topbar">
    <h1>Nueva Salida de Bienes</h1>
    <div class="topbar-user"><span><%= usuario.nombre %></span></div>
  </div>
  <div class="page-content">
    <% if (error && error.length) { %><div class="alert alert-error">✕ <%= error[0] %></div><% } %>
    <div class="flex items-center mb-16">
      <a href="/salidas" class="btn btn-secondary">← Regresar</a>
    </div>

    <form method="POST" action="/salidas" id="frm-salida">

      <!-- Sección 1: Tipo y destino -->
      <div class="card" style="max-width:900px;margin-bottom:16px">
        <h4 style="margin-bottom:16px;color:var(--gris);font-size:12px;text-transform:uppercase;letter-spacing:.05em">1 · Tipo de salida y destino</h4>
        <div class="form-grid">
          <div class="form-group">
            <label>Tipo de salida *</label>
            <select name="tipo" id="sel-tipo" required onchange="actualizarFormulario()">
              <option value="">— Seleccionar —</option>
              <% Object.entries(TIPOS).forEach(([v,l]) => { %>
                <option value="<%= v %>"><%= l %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Fecha de salida *</label>
            <input type="date" name="fecha_salida" required value="<%= new Date().toISOString().split('T')[0] %>">
          </div>
          <div class="form-group" id="grp-retorno" style="display:none">
            <label>Fecha estimada de retorno</label>
            <input type="date" name="fecha_retorno_estimada">
          </div>
          <div class="form-group form-full">
            <label id="lbl-destino">Destino / Empresa *</label>
            <input type="text" name="destino_nombre" required placeholder="Nombre de la empresa, unidad médica o institución">
          </div>
          <div class="form-group">
            <label>Responsable receptor</label>
            <input type="text" name="destino_responsable" placeholder="Nombre de quien recibe">
          </div>
          <div class="form-group">
            <label>Cargo</label>
            <input type="text" name="destino_cargo" placeholder="Cargo o puesto">
          </div>
        </div>
      </div>

      <!-- Sección 2: Autorización -->
      <div class="card" style="max-width:900px;margin-bottom:16px" id="grp-autorizante">
        <h4 style="margin-bottom:16px;color:var(--gris);font-size:12px;text-transform:uppercase;letter-spacing:.05em">2 · Autorización</h4>
        <div class="form-grid">
          <div class="form-group">
            <label>Nombre del autorizante</label>
            <input type="text" name="autorizante_nombre" placeholder="Quien autoriza la salida">
          </div>
          <div class="form-group">
            <label>Cargo del autorizante</label>
            <input type="text" name="autorizante_cargo" placeholder="Ej. Jefe de Servicios Generales">
          </div>
          <div class="form-group form-full">
            <label>Motivo</label>
            <textarea name="motivo" rows="2" placeholder="Motivo o justificación de la salida..."></textarea>
          </div>
          <div class="form-group form-full">
            <label>Observaciones adicionales</label>
            <textarea name="observaciones" rows="2"></textarea>
          </div>
        </div>
      </div>

      <!-- Sección 3: Selección de bienes -->
      <div class="card" style="margin-bottom:16px">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;flex-wrap:wrap;gap:8px">
          <h4 style="color:var(--gris);font-size:12px;text-transform:uppercase;letter-spacing:.05em;margin:0">3 · Seleccionar bienes</h4>
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <input type="text" id="filtro-bienes" placeholder="Filtrar por nombre, folio o área..." style="width:220px;font-size:13px">
            <select id="filtro-area" style="font-size:13px">
              <option value="">Todas las áreas</option>
              <% areas.forEach(a => { %><option value="<%= a.nombre %>"><%= a.nombre %></option><% }) %>
            </select>
            <button type="button" onclick="selAll(true)" class="btn btn-sm btn-secondary">Todos</button>
            <button type="button" onclick="selAll(false)" class="btn btn-sm btn-secondary">Ninguno</button>
          </div>
        </div>
        <p class="text-sm text-gris" style="margin-bottom:10px">
          Se muestran los bienes en estado Activo, En mantenimiento o En traslado.
        </p>
        <div class="table-wrap" style="max-height:400px;overflow-y:auto">
          <table id="tbl-bienes">
            <thead style="position:sticky;top:0;z-index:1">
              <tr>
                <th style="width:36px"><input type="checkbox" id="chk-all" onchange="selAll(this.checked)"></th>
                <th>N° Inventario</th><th>Nombre</th><th>Categoría</th><th>Área</th><th>Estado</th><th>Condición</th>
              </tr>
            </thead>
            <tbody>
            <% bienes.forEach(b => { %>
              <tr data-nombre="<%= (b.nombre+' '+b.numero_inventario+' '+(b.area_nombre||'')).toLowerCase() %>"
                  data-area="<%= b.area_nombre||'' %>">
                <td><input type="checkbox" name="bienes_ids" value="<%= b.id %>" class="chk-bien"></td>
                <td><strong style="font-size:12px"><%= b.numero_inventario %></strong></td>
                <td style="font-size:13px"><%= b.nombre %><% if(b.marca){ %><br><span class="text-gris text-sm"><%= b.marca %><% if(b.modelo) { %> · <%= b.modelo %><% } %></span><% } %></td>
                <td class="text-sm"><%= CATEGORIAS[b.categoria]||b.categoria %></td>
                <td class="text-sm"><%= b.area_nombre||'—' %></td>
                <td class="text-sm">
                  <span class="badge badge-<%= b.estado==='activo'?'enviado':b.estado==='en_mantenimiento'?'en_proceso':'recibido' %>" style="font-size:10px">
                    <%= b.estado==='activo'?'Activo':b.estado==='en_mantenimiento'?'En mant.':'En traslado' %>
                  </span>
                </td>
                <td class="text-sm"><%= b.condicion %></td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
        <p id="seleccionados-msg" style="font-size:12px;color:var(--gris);margin-top:8px">0 bienes seleccionados</p>
      </div>

      <div class="flex gap-8">
        <button type="submit" class="btn btn-primary">Registrar salida</button>
        <a href="/salidas" class="btn btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>
<script src="/js/app.js"></script>
<script>
var RETORNABLES = ['mantenimiento','prestamo'];
var LABELS_DESTINO = {
  mantenimiento: 'Empresa de mantenimiento *',
  prestamo:      'Unidad médica receptora *',
  donacion:      'Institución receptora *',
  baja:          'Destino final / observación *',
};

function actualizarFormulario() {
  var tipo = document.getElementById('sel-tipo').value;
  document.getElementById('grp-retorno').style.display = RETORNABLES.includes(tipo) ? 'block' : 'none';
  var lbl = document.getElementById('lbl-destino');
  lbl.textContent = LABELS_DESTINO[tipo] || 'Destino / Empresa *';
}

function selAll(val) {
  document.querySelectorAll('.chk-bien:not([style*="display:none"])').forEach(function(c) {
    var tr = c.closest('tr');
    if (!tr || tr.style.display !== 'none') c.checked = val;
  });
  document.getElementById('chk-all').checked = val;
  contarSeleccionados();
}

function contarSeleccionados() {
  var n = document.querySelectorAll('.chk-bien:checked').length;
  document.getElementById('seleccionados-msg').textContent = n + ' bien(es) seleccionado(s)';
}

document.querySelectorAll('.chk-bien').forEach(function(c) {
  c.addEventListener('change', contarSeleccionados);
});

// Filtros en tiempo real
function filtrarTabla() {
  var txt = document.getElementById('filtro-bienes').value.toLowerCase();
  var area = document.getElementById('filtro-area').value;
  document.querySelectorAll('#tbl-bienes tbody tr').forEach(function(tr) {
    var matchTxt = !txt || tr.dataset.nombre.includes(txt);
    var matchArea = !area || tr.dataset.area === area;
    tr.style.display = (matchTxt && matchArea) ? '' : 'none';
  });
}
document.getElementById('filtro-bienes').addEventListener('input', filtrarTabla);
document.getElementById('filtro-area').addEventListener('change', filtrarTabla);
</script>
</body></html>
