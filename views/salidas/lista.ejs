<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css?v=11">
</head>
<body>
<%- include('../layout/sidebar') %>
<div class="main-wrapper">
  <div class="topbar">
    <h1>Salidas de Bienes</h1>
    <div class="topbar-user"><span><%= usuario.nombre %></span></div>
  </div>
  <div class="page-content">
    <% if (success && success.length) { %><div class="alert alert-success">✓ <%= success[0] %></div><% } %>
    <% if (error && error.length) { %><div class="alert alert-error">✕ <%= error[0] %></div><% } %>

    <div class="flex items-center justify-between mb-16">
      <% if (!esJefeArea) { %>
        <a href="/salidas/nueva" class="btn btn-primary">+ Nueva Salida</a>
      <% } else { %>
        <span></span>
      <% } %>
    </div>

    <form method="GET" class="filtros-bar" style="margin-bottom:16px">
      <input type="text" name="buscar" placeholder="Buscar por folio o destino..." value="<%= filtros.buscar %>">
      <select name="tipo">
        <option value="">Todos los tipos</option>
        <% Object.entries(TIPOS).forEach(([v,l]) => { %>
          <option value="<%= v %>" <%= filtros.tipo===v?'selected':'' %>><%= l %></option>
        <% }) %>
      </select>
      <select name="estado">
        <option value="">Todos los estados</option>
        <option value="en_curso" <%= filtros.estado==='en_curso'?'selected':'' %>>En curso</option>
        <option value="cerrada" <%= filtros.estado==='cerrada'?'selected':'' %>>Cerrada</option>
      </select>
      <button type="submit" class="btn btn-secondary">Filtrar</button>
      <a href="/salidas" class="btn btn-secondary">Limpiar</a>
    </form>

    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Folio</th><th>Tipo</th><th>Destino</th><th>Bienes</th>
              <th>Fecha salida</th><th>Retorno est.</th><th>Estado</th><th></th>
            </tr>
          </thead>
          <tbody>
          <% if (salidas.length === 0) { %>
            <tr><td colspan="8" class="text-center text-gris" style="padding:30px">Sin salidas registradas</td></tr>
          <% } %>
          <% salidas.forEach(s => { %>
            <tr>
              <td><strong style="font-size:12px;color:var(--verde)"><%= s.folio %></strong></td>
              <td class="text-sm"><%= TIPOS[s.tipo] %></td>
              <td style="font-size:13px;font-weight:600"><%= s.destino_nombre %></td>
              <td class="text-sm text-center"><%= s.total_bienes %></td>
              <td class="text-sm"><%= fmtFecha(s.fecha_salida, false) %></td>
              <td class="text-sm"><%= s.fecha_retorno_estimada ? fmtFecha(s.fecha_retorno_estimada, false) : '—' %></td>
              <td>
                <% if (s.estado === 'cerrada') { %>
                  <span class="badge badge-enviado">Cerrada</span>
                <% } else { %>
                  <span class="badge badge-en_proceso">En curso</span>
                <% } %>
              </td>
              <td style="display:flex;gap:6px">
                <a href="/salidas/<%= s.id %>" class="btn btn-sm btn-secondary">Ver</a>
                <a href="/salidas/<%= s.id %>/pdf" target="_blank" class="btn btn-sm btn-secondary">📄</a>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<script src="/js/app.js"></script>
</body></html>
