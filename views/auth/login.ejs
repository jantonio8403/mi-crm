<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>AGORA — HBC 12 Camas Berriozábal</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div class="login-page">
  <div class="login-card">
    <div class="login-brand">
      <div class="login-icon">A</div>
      <h1>AGORA</h1>
      <p class="login-desc">Sistema de Gestión Administrativa</p>
      <p class="login-hosp">H.B.C. 12 Camas · Berriozábal, Chiapas</p>
    </div>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-error" style="margin-bottom:20px">✕ <%= error[0] %></div>
    <% } %>

    <form method="POST" action="/login">
      <div class="form-group">
        <label>Usuario</label>
        <input type="text" name="username" required autofocus placeholder="Nombre de usuario">
      </div>
      <div class="form-group">
        <label>Contraseña</label>
        <input type="password" name="password" required placeholder="Contraseña">
      </div>
      <button type="submit" class="btn btn-primary">Iniciar sesión</button>
    </form>
  </div>
</div>
</body>
</html>
