<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css?v=12">
</head>
<body>

<%- include('../layout/sidebar') %>

<div class="main-wrapper">
  <div class="topbar">
    <h1>Dashboard</h1>
    <div class="topbar-user">
      <span><%= usuario.nombre %> · <%= usuario.cargo %></span>
    </div>
  </div>
  <div class="page-content">
    <% if (success && success.length > 0) { %><div class="alert alert-success">✓ <%= success[0] %></div><% } %>
    <% if (error && error.length > 0) { %><div class="alert alert-error">✕ <%= error[0] %></div><% } %>

    <!-- Correspondencia stats -->
    <p class="text-sm text-gris" style="margin-bottom:8px;font-weight:600;text-transform:uppercase;letter-spacing:.05em">Correspondencia</p>
    <div class="stats-grid" style="margin-bottom:16px">
      <div class="stat-card">
        <div class="num"><%= stats.oficios_emitidos %></div>
        <div class="label">Oficios emitidos este año</div>
      </div>
      <div class="stat-card">
        <div class="num"><%= stats.memorandums_emitidos %></div>
        <div class="label">Memorándums emitidos</div>
      </div>
      <div class="stat-card">
        <div class="num"><%= stats.entrante_recibidos %></div>
        <div class="label">Correspondencia recibida</div>
      </div>
      <div class="stat-card pendiente">
        <div class="num"><%= stats.entrante_pendientes %></div>
        <div class="label">Pendientes de atención</div>
      </div>
      <div class="stat-card alerta">
        <div class="num"><%= stats.entrante_urgentes %></div>
        <div class="label">Próximos a vencer (3 días)</div>
      </div>
    </div>

    <!-- Tickets stats -->
    <p class="text-sm text-gris" style="margin-bottom:8px;font-weight:600;text-transform:uppercase;letter-spacing:.05em">Tickets internos</p>
    <div class="stats-grid" style="grid-template-columns:repeat(3,1fr);margin-bottom:24px">
      <div class="stat-card">
        <div class="num" style="color:#d97706"><%= stats.tickets_abiertos %></div>
        <div class="label">Tickets abiertos</div>
      </div>
      <div class="stat-card">
        <div class="num" style="color:var(--azul)"><%= stats.tickets_en_proceso %></div>
        <div class="label">En proceso</div>
      </div>
      <div class="stat-card alerta">
        <div class="num"><%= stats.tickets_urgentes %></div>
        <div class="label">Tickets urgentes activos</div>
      </div>
    </div>

    <div class="flex" style="gap:16px;margin-bottom:16px;flex-wrap:wrap">
      <a href="/correspondencia/salientes/nuevo?tipo=oficio" class="btn btn-primary">+ Nuevo Oficio</a>
      <a href="/correspondencia/salientes/nuevo?tipo=memorandum" class="btn btn-secondary">+ Nuevo Memorándum</a>
      <a href="/correspondencia/entrante/nuevo" class="btn btn-secondary">+ Registrar Recibido</a>
      <a href="/tickets/nuevo" class="btn btn-secondary">+ Nuevo Ticket</a>
    </div>

    <% if (urgentes.length > 0) { %>
    <div class="card mb-16">
      <div class="card-header">
        <h3>⚠ Documentos próximos a vencer</h3>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr>
            <th>Asunto</th><th>Remitente</th><th>Área</th><th>Vence</th><th></th>
          </tr></thead>
          <tbody>
          <% urgentes.forEach(d => { %>
            <tr>
              <td class="truncate"><%= d.asunto %></td>
              <td><%= d.remitente_nombre %></td>
              <td><%= d.area_nombre || '—' %></td>
              <td class="text-rojo"><strong><%= d.fecha_limite_respuesta %></strong></td>
              <td><a href="/correspondencia/entrante/<%= d.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <% if (tickets_recientes.length > 0) { %>
    <div class="card mb-16">
      <div class="card-header">
        <h3>🎫 Tickets pendientes</h3>
        <a href="/tickets" class="text-sm text-verde">Ver todos</a>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr>
            <th>Folio</th><th>Título</th><th>Área solicitante</th><th>Prioridad</th><th>Estatus</th><th></th>
          </tr></thead>
          <tbody>
          <% tickets_recientes.forEach(t => { %>
            <tr>
              <td><strong style="font-size:12px"><%= t.folio %></strong></td>
              <td class="truncate"><%= t.titulo %></td>
              <td class="text-sm"><%= t.area_sol_nombre || '—' %></td>
              <td>
                <% const colores = {baja:'#6b7280',media:'#d97706',alta:'#dc2626',urgente:'#7c3aed'}; %>
                <span class="badge" style="background:<%= colores[t.prioridad] %>20;color:<%= colores[t.prioridad] %>">
                  <%= t.prioridad.charAt(0).toUpperCase() + t.prioridad.slice(1) %>
                </span>
              </td>
              <td>
                <span class="badge badge-<%= t.estatus==='en_proceso'?'en_proceso':t.estatus==='abierto'?'recibido':'archivado' %>">
                  <%= t.estatus.replace('_',' ') %>
                </span>
              </td>
              <td><a href="/tickets/<%= t.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <div class="two-col">
      <!-- Últimos salientes -->
      <div class="card">
        <div class="card-header">
          <h3>Últimos documentos emitidos</h3>
          <a href="/correspondencia/salientes" class="text-sm text-verde">Ver todos</a>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Folio</th><th>Tipo</th><th>Asunto</th><th>Estatus</th></tr></thead>
            <tbody>
            <% if (recientes_salientes.length === 0) { %>
              <tr><td colspan="4" class="text-center text-gris" style="padding:20px">Sin documentos aún</td></tr>
            <% } %>
            <% recientes_salientes.forEach(d => { %>
              <tr>
                <td><a href="/correspondencia/salientes/<%= d.id %>"><%= d.numero_folio %></a></td>
                <td><span class="badge badge-<%= d.tipo %>"><%= d.tipo %></span></td>
                <td class="truncate"><%= d.asunto %></td>
                <td><span class="badge badge-<%= d.estatus %>"><%= d.estatus %></span></td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Últimos entrantes -->
      <div class="card">
        <div class="card-header">
          <h3>Últimos recibidos</h3>
          <a href="/correspondencia/entrante" class="text-sm text-verde">Ver todos</a>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Folio ext.</th><th>Remitente</th><th>Estatus</th></tr></thead>
            <tbody>
            <% if (recientes_entrantes.length === 0) { %>
              <tr><td colspan="3" class="text-center text-gris" style="padding:20px">Sin documentos aún</td></tr>
            <% } %>
            <% recientes_entrantes.forEach(d => { %>
              <tr>
                <td><a href="/correspondencia/entrante/<%= d.id %>"><%= d.folio_externo || '—' %></a></td>
                <td class="truncate"><%= d.remitente_nombre %></td>
                <td><span class="badge badge-<%= d.estatus %>"><%= d.estatus %></span></td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>
<script src="/js/app.js?v=12"></script>
</body>
</html>
