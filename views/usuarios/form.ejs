<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css?v=12">
</head>
<body>
<%- include('../layout/sidebar') %>
<div class="main-wrapper">
  <div class="topbar">
    <h1><%= titulo %></h1>
    <div class="topbar-user">
      <span><%= usuario.nombre %></span>
    </div>
  </div>
  <div class="page-content">
    <% if (error && error.length) { %><div class="alert alert-error">✕ <%= error[0] %></div><% } %>

    <div class="flex items-center mb-16">
      <a href="/usuarios" class="btn btn-secondary">← Regresar</a>
    </div>

    <div class="card" style="max-width:680px">
      <form method="POST" action="<%= accion %>">

        <!-- ── Funcionario del directorio ────────────────────────── -->
        <h4 style="margin-bottom:12px;color:var(--gris);font-size:12px;text-transform:uppercase;letter-spacing:.05em">
          Funcionario del directorio interno
        </h4>
        <div class="form-group" style="margin-bottom:20px">
          <label>Vincular con funcionario
            <span style="font-weight:400;font-size:11px;color:var(--gris)"> — nombre, cargo y área se toman del directorio automáticamente</span>
          </label>
          <select name="funcionario_id" id="sel-funcionario">
            <option value=""
                    data-nombre="" data-cargo="" data-area-id="" data-area-nombre="">
              — Sin vínculo (capturar datos manualmente) —
            </option>
            <% funcionariosDisp.forEach(f => { %>
              <option value="<%= f.id %>"
                      data-nombre="<%= f.nombre %>"
                      data-cargo="<%= f.cargo || '' %>"
                      data-area-id="<%= f.area_id || '' %>"
                      data-area-nombre="<%= f.area_nombre || '' %>"
                      <%= linkedFuncionarioId == f.id ? 'selected' : '' %>>
                <%= f.nombre %><% if(f.cargo){ %> — <%= f.cargo %><% } %><% if(f.area_nombre){ %> (<%= f.area_nombre %>)<% } %>
              </option>
            <% }) %>
          </select>
        </div>

        <hr style="border:none;border-top:1px solid var(--borde);margin-bottom:20px">

        <!-- ── Datos personales ──────────────────────────────────── -->
        <h4 style="margin-bottom:12px;color:var(--gris);font-size:12px;text-transform:uppercase;letter-spacing:.05em">
          Datos personales
        </h4>
        <div class="form-grid" style="margin-bottom:20px">
          <div class="form-group form-full">
            <label>Nombre completo *</label>
            <input type="text" name="nombre" id="inp-nombre" required
                   value="<%= usuarioEdit ? usuarioEdit.nombre : '' %>"
                   placeholder="Nombre completo del usuario">
          </div>
          <div class="form-group">
            <label>Cargo / Puesto</label>
            <input type="text" name="cargo" id="inp-cargo"
                   value="<%= usuarioEdit ? (usuarioEdit.cargo || '') : '' %>"
                   placeholder="Ej. Jefe de Enfermería">
          </div>
          <div class="form-group" id="div-area-editable">
            <label>Área</label>
            <select name="area_id" id="sel-area-manual">
              <option value="">— Sin área asignada —</option>
              <% areas.forEach(a => { %>
                <option value="<%= a.id %>"
                  <%= usuarioEdit && usuarioEdit.area_id == a.id ? 'selected' : '' %>>
                  <%= a.nombre %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="form-group" id="div-area-readonly" style="display:none">
            <label>Área</label>
            <input type="hidden" name="area_id" id="inp-area-id">
            <input type="text"   id="inp-area-nombre" readonly
                   style="background:var(--verde-fondo);color:var(--gris);cursor:default"
                   placeholder="— Sin área —">
          </div>
        </div>

        <hr style="border:none;border-top:1px solid var(--borde);margin-bottom:20px">

        <!-- ── Acceso al sistema ─────────────────────────────────── -->
        <h4 style="margin-bottom:12px;color:var(--gris);font-size:12px;text-transform:uppercase;letter-spacing:.05em">
          Acceso al sistema
        </h4>
        <div class="form-grid">
          <div class="form-group">
            <label>Nombre de usuario *</label>
            <input type="text" name="username" required
                   value="<%= usuarioEdit ? usuarioEdit.username : '' %>"
                   placeholder="Sin espacios ni caracteres especiales"
                   data-no-upper autocomplete="off">
          </div>
          <div class="form-group">
            <label>Rol *</label>
            <select name="rol" required>
              <% Object.entries(ROLES).forEach(([val, label]) => { %>
                <option value="<%= val %>"
                  <%= usuarioEdit && usuarioEdit.rol === val ? 'selected' :
                     (val === 'secretaria' && !usuarioEdit ? 'selected' : '') %>>
                  <%= label %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="form-group form-full">
            <label><%= usuarioEdit ? 'Nueva contraseña (dejar vacío para no cambiar)' : 'Contraseña *' %></label>
            <input type="password" name="password"
                   <%= !usuarioEdit ? 'required' : '' %>
                   placeholder="Mínimo 6 caracteres"
                   autocomplete="new-password">
          </div>
        </div>

        <div class="flex gap-8 mt-16">
          <button type="submit" class="btn btn-primary">
            <%= usuarioEdit ? 'Guardar cambios' : 'Crear usuario' %>
          </button>
          <a href="/usuarios" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>
<script src="/js/app.js?v=12"></script>
<script>
(function () {
  var sel          = document.getElementById('sel-funcionario');
  var inpNombre    = document.getElementById('inp-nombre');
  var inpCargo     = document.getElementById('inp-cargo');
  var divAreaEd    = document.getElementById('div-area-editable');
  var divAreaRO    = document.getElementById('div-area-readonly');
  var inpAreaId    = document.getElementById('inp-area-id');
  var inpAreaNom   = document.getElementById('inp-area-nombre');
  if (!sel) return;

  function bloquear(inp) {
    inp.readOnly = true;
    inp.style.background = 'var(--verde-fondo)';
    inp.style.color      = 'var(--gris)';
    inp.style.cursor     = 'default';
  }
  function liberar(inp) {
    inp.readOnly = false;
    inp.style.background = '';
    inp.style.color      = '';
    inp.style.cursor     = '';
  }

  function actualizar() {
    var opt = sel.options[sel.selectedIndex];
    if (sel.value) {
      inpNombre.value = opt.dataset.nombre || '';
      bloquear(inpNombre);
      inpCargo.value  = opt.dataset.cargo  || '';
      bloquear(inpCargo);
      divAreaEd.style.display  = 'none';
      divAreaRO.style.display  = 'block';
      inpAreaId.value  = opt.dataset.areaId  || '';
      inpAreaNom.value = opt.dataset.areaNombre || '— Sin área —';
    } else {
      liberar(inpNombre);
      liberar(inpCargo);
      divAreaEd.style.display = 'block';
      divAreaRO.style.display = 'none';
      inpAreaId.value  = '';
      inpAreaNom.value = '';
    }
  }

  sel.addEventListener('change', actualizar);
  actualizar();
}());
</script>
</body></html>
