<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css?v=5">
</head>
<body>
<%- include('layout/sidebar') %>
<div class="main-wrapper">
  <div class="topbar">
    <h1>Mi Perfil</h1>
    <div class="topbar-user">
      <span><%= usuario.nombre %></span>
      <a href="/logout">Cerrar sesión</a>
    </div>
  </div>
  <div class="page-content">
    <% if (success && success.length) { %><div class="alert alert-success">✓ <%= success[0] %></div><% } %>
    <% if (error && error.length) { %><div class="alert alert-error">✕ <%= error[0] %></div><% } %>

    <div class="two-col" style="align-items:start;max-width:900px">

      <!-- Datos del usuario -->
      <div class="card">
        <div class="card-header"><h3>Información personal</h3></div>
        <div class="detalle-grid">
          <div class="detalle-item">
            <label>Nombre completo</label>
            <p><%= usuario_db.nombre %></p>
          </div>
          <div class="detalle-item">
            <label>Usuario</label>
            <p><code style="background:var(--gris-claro);padding:2px 6px;border-radius:4px;font-size:13px"><%= usuario_db.username %></code></p>
          </div>
          <div class="detalle-item">
            <label>Cargo</label>
            <p><%= usuario_db.cargo || '—' %></p>
          </div>
          <div class="detalle-item">
            <label>Rol en el sistema</label>
            <p>
              <% const roles = {admin:'Administrador',director:'Director',jefe_area:'Jefe de Área',secretaria:'Secretaria',recepcion:'Recepción'}; %>
              <span class="badge" style="background:var(--verde-fondo);color:var(--verde)"><%= roles[usuario_db.rol] || usuario_db.rol %></span>
            </p>
          </div>
          <div class="detalle-item full">
            <label>Área</label>
            <p><%= usuario_db.area_nombre || '—' %></p>
          </div>
        </div>
      </div>

      <!-- Cambiar contraseña -->
      <div class="card">
        <div class="card-header"><h3>Cambiar contraseña</h3></div>
        <form method="POST" action="/perfil/password">
          <div class="form-grid" style="grid-template-columns:1fr">
            <div class="form-group">
              <label>Contraseña actual *</label>
              <input type="password" name="password_actual" required autocomplete="current-password">
            </div>
            <div class="form-group">
              <label>Nueva contraseña *</label>
              <input type="password" name="password_nuevo" required minlength="6" autocomplete="new-password"
                placeholder="Mínimo 6 caracteres">
            </div>
            <div class="form-group">
              <label>Confirmar nueva contraseña *</label>
              <input type="password" name="password_confirm" required minlength="6" autocomplete="new-password">
            </div>
          </div>
          <div class="flex gap-8 mt-16">
            <button type="submit" class="btn btn-primary">Actualizar contraseña</button>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>
<script src="/js/app.js"></script>
</body></html>
