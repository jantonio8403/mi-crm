<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title><%= bien.numero_inventario %> — Actualizar</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <style>
    :root {
      --verde: #1a7a4a; --verde-oscuro: #0b3320;
      --borde: #e5e7eb; --gris: #6b7280; --fondo: #f9fafb;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body { font-family: -apple-system, Arial, sans-serif; background: var(--fondo); color: #111;
           min-height: 100dvh; padding-bottom: 100px; }

    /* Header */
    .header { background: var(--verde-oscuro); color: #fff; padding: 14px 16px 12px;
               position: sticky; top: 0; z-index: 10; }
    .header-back { font-size: 12px; color: #6ee7b7; text-decoration: none; display: inline-block; margin-bottom: 4px; }
    .header-folio { font-size: 11px; font-weight: 700; color: #6ee7b7; letter-spacing: .08em; }
    .header-nombre { font-size: 16px; font-weight: 800; line-height: 1.2; margin: 2px 0; }
    .header-meta { font-size: 11px; color: #a7f3d0; }

    /* Alertas */
    .alert { margin: 12px 16px; padding: 10px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; }
    .alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; }
    .alert-error   { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; }

    /* Secciones */
    .seccion { background: #fff; border-radius: 12px; margin: 12px 16px; padding: 16px; }
    .seccion-titulo { font-size: 10px; font-weight: 700; text-transform: uppercase;
                      letter-spacing: .08em; color: var(--gris); margin-bottom: 12px; }

    /* Fotos */
    .fotos-grid { display: flex; flex-wrap: wrap; gap: 8px; }
    .foto-thumb { width: 80px; height: 80px; object-fit: cover; border-radius: 8px;
                  border: 1px solid var(--borde); }
    .foto-vacia { width: 80px; height: 80px; border-radius: 8px; border: 2px dashed #d1d5db;
                  display: flex; align-items: center; justify-content: center;
                  font-size: 10px; color: var(--gris); text-align: center; line-height: 1.3; }
    .btn-camara { display: flex; align-items: center; justify-content: center; gap: 6px;
                  width: 100%; margin-top: 12px; padding: 12px;
                  background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 10px;
                  font-size: 14px; font-weight: 600; color: var(--verde); cursor: pointer;
                  position: relative; overflow: hidden; }
    .btn-camara input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; font-size: 0; }
    .fotos-preview { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .fotos-preview img { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 2px solid #86efac; }

    /* Condición — radio grande */
    .condicion-opts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .cond-label { display: block; border: 2px solid var(--borde); border-radius: 10px;
                  padding: 14px 8px; text-align: center; cursor: pointer; transition: all .15s; }
    .cond-label input { display: none; }
    .cond-label .cond-icono { font-size: 22px; display: block; margin-bottom: 4px; }
    .cond-label .cond-texto { font-size: 12px; font-weight: 700; }
    .cond-label.bueno:has(input:checked)   { background: #f0fdf4; border-color: #16a34a; color: #15803d; }
    .cond-label.regular:has(input:checked) { background: #fffbeb; border-color: #d97706; color: #92400e; }
    .cond-label.malo:has(input:checked)    { background: #fef2f2; border-color: #dc2626; color: #b91c1c; }

    /* Campos */
    .campo { margin-bottom: 14px; }
    .campo label { font-size: 11px; font-weight: 700; text-transform: uppercase;
                   letter-spacing: .05em; color: var(--gris); display: block; margin-bottom: 6px; }
    .campo input, .campo select, .campo textarea {
      width: 100%; padding: 12px 14px; font-size: 16px; border: 1.5px solid var(--borde);
      border-radius: 10px; background: #fff; color: #111; appearance: none; outline: none;
      font-family: inherit;
    }
    .campo input:focus, .campo select:focus, .campo textarea:focus {
      border-color: var(--verde); box-shadow: 0 0 0 3px #bbf7d040;
    }
    .campo textarea { resize: vertical; min-height: 80px; }

    /* Botón guardar fijo */
    .footer-btn { position: fixed; bottom: 0; left: 0; right: 0;
                  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
                  background: #fff; border-top: 1px solid var(--borde); z-index: 10; }
    .btn-guardar { width: 100%; padding: 16px; background: var(--verde-oscuro); color: #fff;
                   border: none; border-radius: 12px; font-size: 16px; font-weight: 700;
                   cursor: pointer; letter-spacing: .02em; }
    .btn-guardar:active { opacity: .85; }
  </style>
</head>
<body>

<div class="header">
  <a href="/inventario/<%= bien.id %>" class="header-back">← Ver detalle completo</a>
  <div class="header-folio"><%= bien.numero_inventario %></div>
  <div class="header-nombre"><%= bien.nombre %></div>
  <div class="header-meta">
    <%= bien.area_nombre || 'Sin área' %>
    <% if (bien.resguardante) { %> · <%= bien.resguardante %><% } %>
  </div>
</div>

<% if (success && success.length) { %><div class="alert alert-success">✓ <%= success[0] %></div><% } %>
<% if (error && error.length) { %><div class="alert alert-error">✕ <%= error[0] %></div><% } %>

<form method="POST" action="/inventario/<%= bien.id %>/actualizar" enctype="multipart/form-data" id="form-actualizar">

  <!-- Fotografías -->
  <div class="seccion">
    <div class="seccion-titulo">Fotografías (<%= fotos.length %>)</div>
    <div class="fotos-grid" id="galeria-actual">
      <% fotos.forEach(f => { %>
        <a href="/uploads/inventario/<%= f.filename %>" target="_blank">
          <img src="/uploads/inventario/<%= f.filename %>" class="foto-thumb" loading="lazy">
        </a>
      <% }) %>
      <% if (fotos.length === 0) { %>
        <div class="foto-vacia">Sin fotos</div>
      <% } %>
    </div>

    <label class="btn-camara">
      📷 Tomar o seleccionar foto
      <input type="file" name="fotos" accept="image/*" capture="environment"
             multiple id="inp-fotos">
    </label>
    <div class="fotos-preview" id="preview-nuevas"></div>
  </div>

  <!-- Condición -->
  <div class="seccion">
    <div class="seccion-titulo">Condición actual</div>
    <div class="condicion-opts">
      <label class="cond-label bueno">
        <input type="radio" name="condicion" value="bueno" <%= bien.condicion === 'bueno' ? 'checked' : '' %> required>
        <span class="cond-icono">🟢</span>
        <span class="cond-texto">Bueno</span>
      </label>
      <label class="cond-label regular">
        <input type="radio" name="condicion" value="regular" <%= bien.condicion === 'regular' ? 'checked' : '' %>>
        <span class="cond-icono">🟡</span>
        <span class="cond-texto">Regular</span>
      </label>
      <label class="cond-label malo">
        <input type="radio" name="condicion" value="malo" <%= bien.condicion === 'malo' ? 'checked' : '' %>>
        <span class="cond-icono">🔴</span>
        <span class="cond-texto">Malo</span>
      </label>
    </div>
  </div>

  <!-- Estado y resguardante -->
  <div class="seccion">
    <div class="campo">
      <label>Estado</label>
      <select name="estado">
        <% Object.entries(ESTADOS).forEach(([v, l]) => { %>
          <option value="<%= v %>" <%= bien.estado === v ? 'selected' : '' %>><%= l %></option>
        <% }) %>
      </select>
    </div>
    <div class="campo">
      <label>Resguardante</label>
      <input type="text" name="resguardante" value="<%= bien.resguardante || '' %>"
             placeholder="Nombre del responsable" autocomplete="name">
    </div>
    <div class="campo" style="margin-bottom:0">
      <label>Observaciones</label>
      <textarea name="observaciones" placeholder="Notas sobre el estado actual del bien..."><%= bien.observaciones || '' %></textarea>
    </div>
  </div>

</form>

<div class="footer-btn">
  <button type="submit" form="form-actualizar" class="btn-guardar">Guardar cambios</button>
</div>

<script>
document.getElementById('inp-fotos').addEventListener('change', function () {
  var prev = document.getElementById('preview-nuevas');
  prev.innerHTML = '';
  Array.from(this.files).forEach(function (f) {
    var reader = new FileReader();
    reader.onload = function (e) {
      var img = document.createElement('img');
      img.src = e.target.result;
      prev.appendChild(img);
    };
    reader.readAsDataURL(f);
  });
});
</script>
</body></html>
