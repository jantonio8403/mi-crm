<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tickets — HBC Berriozabal</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; font-size: 11px; color: #111; background: #fff; padding: 20px; }

    .encabezado { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 2px solid #1a7a4a; }
    .encabezado-left h1 { font-size: 15px; font-weight: 700; color: #1a7a4a; }
    .encabezado-left p  { font-size: 10px; color: #555; margin-top: 2px; }
    .encabezado-right   { text-align: right; font-size: 10px; color: #555; }

    .filtros-resumen { background: #f5f5f5; border: 1px solid #ddd; border-radius: 4px; padding: 6px 10px; margin-bottom: 12px; font-size: 10px; color: #444; }
    .filtros-resumen strong { color: #111; }

    table { width: 100%; border-collapse: collapse; }
    th { background: #0b3320; color: #fff; padding: 6px 8px; text-align: left; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
    td { padding: 5px 8px; border-bottom: 1px solid #e5e5e5; vertical-align: top; }
    tr:nth-child(even) td { background: #f9f9f9; }

    .folio   { font-weight: 700; font-size: 10px; white-space: nowrap; }
    .titulo  { max-width: 220px; }
    .badge   { display: inline-block; padding: 2px 6px; border-radius: 3px; font-size: 9px; font-weight: 600; }

    .pie { margin-top: 16px; font-size: 9px; color: #888; text-align: right; }

    @media print {
      body { padding: 0; }
      @page { margin: 15mm 12mm; size: landscape; }
    }
  </style>
</head>
<body>

<div class="encabezado">
  <div class="encabezado-left">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px">
      <div style="width:26px;height:26px;background:#1a7a4a;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:900;color:#fff;flex-shrink:0">A</div>
      <span style="font-size:18px;font-weight:800;color:#1a7a4a;letter-spacing:2px">GORA</span>
      <span style="font-size:10px;color:#555;border-left:1px solid #ccc;padding-left:8px;line-height:1.3">Sistema de Gestión Administrativa<br>H.B.C. 12 Camas · Berriozábal, Chiapas</span>
    </div>
    <p style="font-size:10px;color:#888;margin-top:2px">Reporte de Tickets Internos</p>
  </div>
  <div class="encabezado-right">
    <p><strong>Generado:</strong> <%= generadoEn %></p>
    <p><strong>Por:</strong> <%= generadoPor %></p>
    <p><strong>Total:</strong> <%= tickets.length %> ticket<%= tickets.length !== 1 ? 's' : '' %></p>
  </div>
</div>

<%
  const etiquetas = [];
  if (filtros.estatus)   etiquetas.push('Estatus: ' + filtros.estatus.replace('_',' '));
  if (filtros.prioridad) etiquetas.push('Prioridad: ' + PRIORIDADES[filtros.prioridad].label);
  if (filtros.categoria) etiquetas.push('Categoría: ' + CATEGORIAS[filtros.categoria]);
  if (filtros.area) {
    const areaEnc = areas.find(a => a.id == filtros.area);
    if (areaEnc) etiquetas.push('Área: ' + areaEnc.nombre);
  }
  if (filtros.buscar)    etiquetas.push('Búsqueda: "' + filtros.buscar + '"');
%>
<div class="filtros-resumen">
  <strong>Filtros aplicados:</strong>
  <%= etiquetas.length ? etiquetas.join(' · ') : 'Ninguno (todos los tickets)' %>
</div>

<table>
  <thead>
    <tr>
      <th>Folio</th>
      <th>Título</th>
      <th>Área solicitante</th>
      <th>Área responsable</th>
      <th>Estatus</th>
      <th>Creado</th>
      <th>Fecha cierre</th>
      <th>Comentario de resolución</th>
    </tr>
  </thead>
  <tbody>
  <% if (tickets.length === 0) { %>
    <tr><td colspan="8" style="text-align:center;padding:20px;color:#888">Sin resultados para los filtros seleccionados</td></tr>
  <% } %>
  <% tickets.forEach(t => { %>
    <tr>
      <td class="folio"><%= t.folio %></td>
      <td class="titulo"><%= t.titulo %></td>
      <td><%= t.area_sol_nombre  || '—' %></td>
      <td><%= t.area_asig_nombre || '—' %></td>
      <td>
        <span class="badge" style="background:#e5e7eb;color:#374151">
          <%= t.estatus.replace('_',' ') %>
        </span>
      </td>
      <td style="white-space:nowrap"><%= fmtFecha(t.creado_en) %></td>
      <td style="white-space:nowrap"><%= fmtFecha(t.cerrado_en, false) %></td>
      <td style="font-size:10px;color:#444"><%= t.comentario_resolucion || '—' %></td>
    </tr>
  <% }) %>
  </tbody>
</table>

<div class="pie">
  Sistema AGORA · HBC Berriozábal · <%= generadoEn %>
</div>

<script>window.addEventListener('load', function(){ window.print(); });</script>
</body>
</html>
