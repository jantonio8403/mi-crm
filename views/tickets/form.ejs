<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css?v=10">
</head>
<body>
<%- include('../layout/sidebar') %>
<div class="main-wrapper">
  <div class="topbar">
    <h1><%= titulo %></h1>
    <div class="topbar-user">
      <span><%= usuario.nombre %></span>
    </div>
  </div>
  <div class="page-content">
    <div class="flex items-center mb-16">
      <a href="/tickets" class="btn btn-secondary">← Regresar</a>
    </div>

    <div class="card" style="max-width:720px">
      <form method="POST" action="<%= accion %>">

        <div style="background:var(--verde-fondo);border:1px solid var(--borde);border-radius:6px;padding:10px 16px;margin-bottom:20px">
          <strong>Folio:</strong>
          <span style="font-size:16px;font-weight:700;color:var(--verde);margin-left:8px"><%= folio.folio %></span>
        </div>

        <div class="form-grid">
          <div class="form-group form-full">
            <label>Título del problema / solicitud *</label>
            <input type="text" name="titulo" required placeholder="Describe brevemente el problema o solicitud">
          </div>

          <div class="form-group">
            <label>Categoría * <span id="badge-categoria" style="display:none;font-size:10px;font-weight:600;color:var(--verde);margin-left:4px">✦ sugerido</span></label>
            <select name="categoria" required id="sel-categoria">
              <% Object.entries(CATEGORIAS).forEach(([v,l]) => { %>
                <option value="<%= v %>"><%= l %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Prioridad *</label>
            <select name="prioridad" required>
              <% Object.entries(PRIORIDADES).forEach(([v,p]) => { %>
                <option value="<%= v %>" <%= v==='media'?'selected':'' %>><%= p.label %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Área solicitante</label>
            <% if (canElegirAreas) { %>
              <select name="area_solicitante_id">
                <option value="">— Seleccionar área —</option>
                <% areas.forEach(a => { %>
                  <option value="<%= a.id %>" <%= usuario.area_id == a.id ? 'selected' : '' %>><%= a.nombre %></option>
                <% }) %>
              </select>
            <% } else { %>
              <input type="hidden" name="area_solicitante_id" value="<%= usuario.area_id || '' %>">
              <input type="text" value="<%= areas.find(a => a.id == usuario.area_id)?.nombre || '—' %>" disabled>
            <% } %>
          </div>

          <div class="form-group">
            <label>Área responsable <span id="badge-area" style="display:none;font-size:10px;font-weight:600;color:var(--verde);margin-left:4px">✦ sugerido</span></label>
            <select name="area_asignada_id" id="sel-area-asig" <%= canElegirAreas ? '' : 'disabled' %>>
              <option value="">— Sin asignar —</option>
              <% areas.forEach(a => { %>
                <option value="<%= a.id %>"><%= a.nombre %></option>
              <% }) %>
            </select>
            <% if (!canElegirAreas) { %>
              <span style="font-size:11px;color:var(--gris)">El área responsable será asignada por dirección o administración.</span>
            <% } %>
          </div>

          <div class="form-group">
            <label>Fecha límite de resolución</label>
            <input type="date" name="fecha_limite">
          </div>

          <div class="form-group form-full">
            <label>Descripción detallada *</label>
            <textarea name="descripcion" required rows="6"
              placeholder="Describe el problema con detalle: qué pasó, cuándo, dónde, qué se necesita..."></textarea>
          </div>
        </div>

        <div class="flex gap-8 mt-16">
          <button type="submit" class="btn btn-primary">Crear ticket</button>
          <a href="/tickets" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>
<script src="/js/app.js"></script>
<script>
window._AREAS = <%- JSON.stringify(areas.map(function(a){return{id:a.id,nombre:a.nombre};})) %>;
(function () {
  var KEYWORDS = {
    informatica: [
      'computadora','computadoras','pc','laptop','laptops','impresora','impresoras',
      'toner','red','internet','sistema','sistemas','correo','pantalla','teclado',
      'raton','mouse','cable','wifi','servidor','monitor','usb','disco','escaner',
      'proyector','software','programa','aplicacion','contraseña','acceso','clave',
      'equipo','tecnologia','computo','celular','telefono','soporte','tecnico',
      'red local','disco duro','memoria','actualizacion','antivirus','base de datos'
    ],
    mantenimiento: [
      'fuga','tuberia','luz','foco','electrico','electricidad','plomeria','puerta',
      'ventana','techo','piso','pintura','instalacion','gotear','goteo','humedad',
      'cisterna','drenaje','desague','llave','grifo','lampara','apagador','contacto',
      'tomacorriente','aire acondicionado','calefaccion','gas','extractor','ventilador',
      'barda','pared','grieta','gotera','inundacion','corto','corto circuito','falla electrica'
    ],
    recursos_materiales: [
      'material','materiales','insumo','insumos','medicamento','medicamentos','medicina',
      'instrumento','camilla','silla','mesa','mueble','suministro','compra','adquisicion',
      'falta','escasez','abasto','inventario','papeleria','papel','tinta','cartucho',
      'guante','cubrebocas','mascarilla','jeringa','aguja','venda','gasa','alcohol',
      'jabón','desinfectante','reactivo','reactivos','equipo medico','material de curacion',
      'lanceta','cateter','solucion','soluciones','ampolleta'
    ],
  };

  var AREA_MATCH = {
    informatica:         ['informatic','sistem','computo','tecnolog'],
    mantenimiento:       ['mantenimiento'],
    recursos_materiales: ['recurso','material','almacen','abastec'],
  };

  var selCategoria = document.getElementById('sel-categoria');
  var selArea      = document.getElementById('sel-area-asig');
  var inpTitulo    = document.querySelector('input[name="titulo"]');
  var inpDesc      = document.querySelector('textarea[name="descripcion"]');
  var badgeCat     = document.getElementById('badge-categoria');
  var badgeArea    = document.getElementById('badge-area');
  if (!selCategoria || !inpTitulo) return;

  var areas = window._AREAS || [];

  function norm(s) {
    return String(s).toLowerCase()
      .normalize('NFD').replace(/[̀-ͯ]/g,'')
      .replace(/[^a-z0-9 ]/g,' ');
  }

  function puntaje(texto) {
    var t = norm(texto);
    var scores = {};
    Object.keys(KEYWORDS).forEach(function(cat) {
      scores[cat] = 0;
      KEYWORDS[cat].forEach(function(p) {
        if (t.indexOf(norm(p)) !== -1) scores[cat] += p.length > 6 ? 2 : 1;
      });
    });
    return scores;
  }

  function sugerir() {
    var texto = (inpTitulo.value + ' ' + (inpDesc ? inpDesc.value : '')).trim();
    if (texto.length < 6) return;

    var scores  = puntaje(texto);
    var entries = Object.keys(scores).map(function(k){ return [k, scores[k]]; })
                        .sort(function(a,b){ return b[1]-a[1]; });
    var maxScore = entries[0][1];
    if (maxScore === 0) return;

    var ganadora = entries[0][0];

    if (selCategoria.value !== ganadora) {
      selCategoria.value = ganadora;
      if (badgeCat) badgeCat.style.display = 'inline';
    }

    if (selArea && areas.length) {
      var keys = AREA_MATCH[ganadora] || [];
      var match = null;
      areas.forEach(function(a) {
        var n = norm(a.nombre);
        if (!match && keys.some(function(k){ return n.indexOf(k) !== -1; })) match = a;
      });
      if (match && selArea.value != match.id) {
        selArea.value = match.id;
        if (badgeArea) badgeArea.style.display = 'inline';
      }
    }
  }

  var timer;
  function debounce(fn, ms) { clearTimeout(timer); timer = setTimeout(fn, ms); }

  inpTitulo.addEventListener('input', function(){ debounce(sugerir, 500); });
  if (inpDesc) inpDesc.addEventListener('input', function(){ debounce(sugerir, 700); });

  selCategoria.addEventListener('change', function(){
    if (badgeCat) badgeCat.style.display = 'none';
  });
  if (selArea) selArea.addEventListener('change', function(){
    if (badgeArea) badgeArea.style.display = 'none';
  });
}());
</script>
</body></html>
