<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css?v=10">
</head>
<body>
<%- include('../layout/sidebar') %>
<div class="main-wrapper">
  <div class="topbar">
    <h1><%= titulo %></h1>
    <div class="topbar-user">
      <span><%= usuario.nombre %></span>
    </div>
  </div>
  <div class="page-content">
    <div class="flex items-center mb-16">
      <a href="/tickets" class="btn btn-secondary">← Regresar</a>
    </div>

    <div class="card" style="max-width:720px">
      <form method="POST" action="<%= accion %>">

        <div style="background:var(--verde-fondo);border:1px solid var(--borde);border-radius:6px;padding:10px 16px;margin-bottom:20px">
          <strong>Folio:</strong>
          <span style="font-size:16px;font-weight:700;color:var(--verde);margin-left:8px"><%= folio.folio %></span>
        </div>

        <div class="form-grid">
          <div class="form-group form-full">
            <label>Título del problema / solicitud *</label>
            <input type="text" name="titulo" required placeholder="Describe brevemente el problema o solicitud">
          </div>

          <div class="form-group">
            <label>Prioridad *</label>
            <select name="prioridad" required>
              <% Object.entries(PRIORIDADES).forEach(([v,p]) => { %>
                <option value="<%= v %>" <%= v==='media'?'selected':'' %>><%= p.label %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Área responsable <span id="badge-area" style="display:none;font-size:10px;font-weight:600;color:var(--verde);margin-left:4px">✦ detectado</span></label>
            <select id="sel-area-asig" disabled>
              <option value="">Se asigna automáticamente al guardar</option>
              <% areas.forEach(a => { %>
                <option value="<%= a.id %>"><%= a.nombre %></option>
              <% }) %>
            </select>
            <span style="font-size:11px;color:var(--gris)">El sistema detecta el área según el contenido del ticket.</span>
          </div>

          <div class="form-group">
            <label>Fecha límite de resolución</label>
            <input type="date" name="fecha_limite">
          </div>

          <div class="form-group form-full">
            <label>Descripción detallada *</label>
            <textarea name="descripcion" required rows="6"
              placeholder="Describe el problema con detalle: qué pasó, cuándo, dónde, qué se necesita..."></textarea>
          </div>
        </div>

        <div class="flex gap-8 mt-16">
          <button type="submit" class="btn btn-primary">Crear ticket</button>
          <a href="/tickets" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>
<script src="/js/app.js"></script>
<script>
/* Vista previa del área — solo informativo, la asignación real la hace el servidor */
(function () {
  var KEYWORDS = {
    informatica:         ['computadora','pc','laptop','impresora','toner','red','internet','sistema','correo','pantalla','teclado','raton','mouse','cable','wifi','servidor','monitor','usb','disco','escaner','software','programa','aplicacion','computo','celular','telefono','soporte','tecnico','antivirus'],
    mantenimiento:       ['fuga','tuberia','luz','foco','electrico','electricidad','plomeria','puerta','ventana','techo','piso','pintura','gotear','goteo','humedad','cisterna','drenaje','desague','llave','grifo','lampara','apagador','contacto','tomacorriente','aire acondicionado','gas','extractor','pared','grieta','gotera','inundacion','corto circuito'],
    recursos_materiales: ['material','insumo','medicamento','medicina','instrumento','camilla','suministro','compra','adquisicion','falta','escasez','abasto','papel','tinta','cartucho','guante','cubrebocas','mascarilla','jeringa','aguja','venda','gasa','alcohol','desinfectante','reactivo','lanceta','cateter','solucion','ampolleta'],
  };
  var AREA_MATCH = {
    informatica:         ['informatica','sistemas','computo','tecnolog'],
    mantenimiento:       ['mantenimiento','servicio general','servicios generales'],
    recursos_materiales: ['administracion','farmacia','recurso','material'],
  };
  var AREAS = <%- JSON.stringify(areas.map(function(a){return{id:a.id,nombre:a.nombre};})) %>;

  var selArea   = document.getElementById('sel-area-asig');
  var badgeArea = document.getElementById('badge-area');
  var inpTitulo = document.querySelector('input[name="titulo"]');
  var inpDesc   = document.querySelector('textarea[name="descripcion"]');
  if (!selArea || !inpTitulo) return;

  function norm(s) {
    return String(s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9 ]/g,' ');
  }
  function detectar() {
    var texto = norm(inpTitulo.value + ' ' + (inpDesc ? inpDesc.value : ''));
    if (texto.trim().length < 6) return;
    var scores = {};
    Object.keys(KEYWORDS).forEach(function(cat) {
      scores[cat] = 0;
      KEYWORDS[cat].forEach(function(p) { if (texto.indexOf(norm(p)) !== -1) scores[cat] += p.length > 6 ? 2 : 1; });
    });
    var ganadora = Object.keys(scores).sort(function(a,b){ return scores[b]-scores[a]; })[0];
    if (!scores[ganadora]) return;
    var claves = AREA_MATCH[ganadora] || [];
    var match = null;
    AREAS.forEach(function(a) { var n=norm(a.nombre); if (!match && claves.some(function(c){return n.indexOf(norm(c))!==-1;})) match=a; });
    if (match) { selArea.value = match.id; if (badgeArea) badgeArea.style.display = 'inline'; }
  }

  var t;
  inpTitulo.addEventListener('input', function(){ clearTimeout(t); t=setTimeout(detectar,500); });
  if (inpDesc) inpDesc.addEventListener('input', function(){ clearTimeout(t); t=setTimeout(detectar,700); });
}());
</script>
</body></html>
