<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<%- include('../layout/sidebar') %>
<div class="main-wrapper">
  <div class="topbar">
    <h1>Tickets Internos</h1>
    <div class="topbar-user">
      <span><%= usuario.nombre %></span>
      <a href="/logout">Cerrar sesión</a>
    </div>
  </div>
  <div class="page-content">
    <% if (success && success.length) { %><div class="alert alert-success">✓ <%= success[0] %></div><% } %>
    <% if (error && error.length) { %><div class="alert alert-error">✕ <%= error[0] %></div><% } %>

    <!-- Stats -->
    <div class="stats-grid" style="grid-template-columns:repeat(4,1fr)">
      <div class="stat-card">
        <div class="num" style="color:#d97706"><%= stats.abierto %></div>
        <div class="label">Abiertos</div>
      </div>
      <div class="stat-card">
        <div class="num" style="color:var(--azul)"><%= stats.en_proceso %></div>
        <div class="label">En proceso</div>
      </div>
      <div class="stat-card">
        <div class="num" style="color:var(--verde)"><%= stats.resuelto %></div>
        <div class="label">Resueltos</div>
      </div>
      <div class="stat-card">
        <div class="num" style="color:var(--gris)"><%= stats.cerrado %></div>
        <div class="label">Cerrados</div>
      </div>
    </div>

    <div class="flex items-center justify-between mb-16">
      <a href="/tickets/nuevo" class="btn btn-primary">+ Nuevo Ticket</a>
    </div>

    <form method="GET" class="filtros-bar">
      <input type="search" name="buscar" placeholder="Buscar por folio o título..." value="<%= filtros.buscar||'' %>">
      <select name="estatus">
        <option value="">Todos los estatus</option>
        <option value="abierto"     <%= filtros.estatus==='abierto'?'selected':'' %>>Abierto</option>
        <option value="en_proceso"  <%= filtros.estatus==='en_proceso'?'selected':'' %>>En proceso</option>
        <option value="resuelto"    <%= filtros.estatus==='resuelto'?'selected':'' %>>Resuelto</option>
        <option value="cerrado"     <%= filtros.estatus==='cerrado'?'selected':'' %>>Cerrado</option>
      </select>
      <select name="prioridad">
        <option value="">Todas las prioridades</option>
        <% Object.entries(PRIORIDADES).forEach(([v,p]) => { %>
          <option value="<%= v %>" <%= filtros.prioridad===v?'selected':'' %>><%= p.label %></option>
        <% }) %>
      </select>
      <select name="categoria">
        <option value="">Todas las categorías</option>
        <% Object.entries(CATEGORIAS).forEach(([v,l]) => { %>
          <option value="<%= v %>" <%= filtros.categoria===v?'selected':'' %>><%= l %></option>
        <% }) %>
      </select>
      <select name="area">
        <option value="">Todas las áreas</option>
        <% areas.forEach(a => { %>
          <option value="<%= a.id %>" <%= filtros.area==a.id?'selected':'' %>><%= a.nombre %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn-secondary">Filtrar</button>
      <a href="/tickets" class="btn btn-secondary">Limpiar</a>
    </form>

    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Folio</th><th>Prioridad</th><th>Título</th><th>Categoría</th>
              <th>Solicita</th><th>Asignado a</th><th>Estatus</th><th>Fecha límite</th><th></th>
            </tr>
          </thead>
          <tbody>
          <% if (tickets.length === 0) { %>
            <tr><td colspan="9" class="text-center text-gris" style="padding:30px">No hay tickets registrados</td></tr>
          <% } %>
          <% tickets.forEach(t => { %>
            <tr>
              <td><strong style="font-size:12px"><%= t.folio %></strong></td>
              <td>
                <span class="badge" style="background:<%=PRIORIDADES[t.prioridad].color%>20;color:<%=PRIORIDADES[t.prioridad].color%>">
                  <%= PRIORIDADES[t.prioridad].label %>
                </span>
              </td>
              <td class="truncate"><%= t.titulo %></td>
              <td class="text-sm text-gris"><%= CATEGORIAS[t.categoria] %></td>
              <td class="text-sm"><%= t.area_sol_nombre || '—' %></td>
              <td class="text-sm"><%= t.area_asig_nombre || '<span class="text-gris">Sin asignar</span>' %></td>
              <td>
                <span class="badge badge-<%= t.estatus === 'en_proceso' ? 'en_proceso' : t.estatus === 'abierto' ? 'recibido' : t.estatus === 'resuelto' ? 'enviado' : 'archivado' %>">
                  <%= t.estatus.replace('_',' ') %>
                </span>
              </td>
              <td class="text-sm <%= t.fecha_limite && t.fecha_limite <= new Date().toISOString().split('T')[0] && !['resuelto','cerrado'].includes(t.estatus) ? 'text-rojo' : '' %>">
                <%= t.fecha_limite || '—' %>
              </td>
              <td><a href="/tickets/<%= t.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <% if (paginacion.pages > 1) { %>
      <div class="pagination mt-16">
        <% if (paginacion.page > 1) { %>
          <a href="?page=<%= paginacion.page-1 %>&buscar=<%= filtros.buscar||'' %>&estatus=<%= filtros.estatus||'' %>&prioridad=<%= filtros.prioridad||'' %>&categoria=<%= filtros.categoria||'' %>&area=<%= filtros.area||'' %>">‹</a>
        <% } %>
        <% for(let i=1;i<=paginacion.pages;i++){ %>
          <a href="?page=<%= i %>&buscar=<%= filtros.buscar||'' %>&estatus=<%= filtros.estatus||'' %>&prioridad=<%= filtros.prioridad||'' %>&categoria=<%= filtros.categoria||'' %>&area=<%= filtros.area||'' %>"
             class="<%= i===paginacion.page?'activo':'' %>"><%= i %></a>
        <% } %>
        <% if (paginacion.page < paginacion.pages) { %>
          <a href="?page=<%= paginacion.page+1 %>&buscar=<%= filtros.buscar||'' %>&estatus=<%= filtros.estatus||'' %>&prioridad=<%= filtros.prioridad||'' %>&categoria=<%= filtros.categoria||'' %>&area=<%= filtros.area||'' %>">›</a>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</div>
<script src="/js/app.js"></script>
</body></html>
