<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css?v=10">
</head>
<body>
<%- include('../layout/sidebar') %>
<div class="main-wrapper">
  <div class="topbar">
    <h1><%= titulo %></h1>
    <div class="topbar-user">
      <span><%= usuario.nombre %></span>
    </div>
  </div>
  <div class="page-content">
    <% if (error && error.length) { %><div class="alert alert-error">✕ <%= error[0] %></div><% } %>

    <div class="flex items-center mb-16">
      <a href="/tickets/<%= ticket.id %>" class="btn btn-secondary">← Regresar al ticket</a>
    </div>

    <div class="card" style="max-width:720px">
      <form method="POST" action="/tickets/<%= ticket.id %>/editar">

        <div style="background:var(--verde-fondo);border:1px solid var(--borde);border-radius:6px;padding:10px 16px;margin-bottom:20px">
          <strong>Folio:</strong>
          <span style="font-size:16px;font-weight:700;color:var(--verde);margin-left:8px"><%= ticket.folio %></span>
        </div>

        <div class="form-grid">
          <div class="form-group form-full">
            <label>Título del problema / solicitud *</label>
            <input type="text" name="titulo" required value="<%= ticket.titulo %>">
          </div>

          <div class="form-group">
            <label>Categoría *</label>
            <select name="categoria" required>
              <% Object.entries(CATEGORIAS).forEach(([v,l]) => { %>
                <option value="<%= v %>" <%= ticket.categoria===v?'selected':'' %>><%= l %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Prioridad *</label>
            <select name="prioridad" required>
              <% Object.entries(PRIORIDADES).forEach(([v,p]) => { %>
                <option value="<%= v %>" <%= ticket.prioridad===v?'selected':'' %>><%= p.label %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label>Área solicitante</label>
            <% if (canElegirAreas) { %>
              <select name="area_solicitante_id">
                <option value="">— Seleccionar área —</option>
                <% areas.forEach(a => { %>
                  <option value="<%= a.id %>" <%= ticket.area_solicitante_id==a.id?'selected':'' %>><%= a.nombre %></option>
                <% }) %>
              </select>
            <% } else { %>
              <input type="hidden" name="area_solicitante_id" value="<%= ticket.area_solicitante_id || '' %>">
              <input type="text" value="<%= areas.find(a => a.id == ticket.area_solicitante_id)?.nombre || '—' %>" disabled>
            <% } %>
          </div>

          <% if (canElegirAreas) { %>
          <div class="form-group">
            <label>Área responsable</label>
            <select name="area_asignada_id">
              <option value="">— Sin asignar —</option>
              <% areas.forEach(a => { %>
                <option value="<%= a.id %>" <%= ticket.area_asignada_id==a.id?'selected':'' %>><%= a.nombre %></option>
              <% }) %>
            </select>
          </div>
          <% } %>

          <div class="form-group">
            <label>Fecha límite de resolución</label>
            <input type="date" name="fecha_limite" value="<%= ticket.fecha_limite || '' %>">
          </div>

          <div class="form-group form-full">
            <label>Descripción detallada *</label>
            <textarea name="descripcion" required rows="6"><%= ticket.descripcion %></textarea>
          </div>
        </div>

        <div class="flex gap-8 mt-16">
          <button type="submit" class="btn btn-primary">Guardar cambios</button>
          <a href="/tickets/<%= ticket.id %>" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>
<script src="/js/app.js"></script>
</body></html>
