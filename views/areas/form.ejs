<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= titulo %> — HBC Berriozabal</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css?v=5">
</head>
<body>
<%- include('../layout/sidebar') %>
<div class="main-wrapper">
  <div class="topbar">
    <h1><%= titulo %></h1>
    <div class="topbar-user">
      <span><%= usuario.nombre %></span>
      <a href="/logout">Cerrar sesión</a>
    </div>
  </div>
  <div class="page-content">
    <% if (error && error.length) { %><div class="alert alert-error">✕ <%= error[0] %></div><% } %>

    <div class="flex items-center mb-16">
      <a href="/areas" class="btn btn-secondary">← Regresar</a>
    </div>

    <div class="card" style="max-width:560px">
      <form method="POST" action="<%= accion %>">
        <div class="form-grid">
          <div class="form-group" style="grid-column:1/-1">
            <label>Nombre del área *</label>
            <input type="text" name="nombre" required maxlength="100"
              value="<%= area ? area.nombre : '' %>" placeholder="Ej. Dirección, Enfermería...">
          </div>
          <div class="form-group">
            <label>Código de área *
              <span style="font-weight:400;font-size:11px;color:var(--gris)"> — aparece en el folio: OFI/<strong>DIR</strong>/0001/2026</span>
            </label>
            <input type="text" name="codigo" required maxlength="10"
              style="text-transform:uppercase;letter-spacing:.1em;font-weight:700;max-width:140px"
              value="<%= area && area.codigo ? area.codigo : '' %>"
              placeholder="DIR, ADM, ENF..."
              oninput="this.value=this.value.toUpperCase().replace(/[^A-Z0-9]/g,'')">
          </div>
          <div class="form-group">
            <label>Jefe de área
              <span style="font-weight:400;font-size:11px;color:var(--gris)"> — busca en el directorio interno</span>
            </label>
            <div style="position:relative">
              <input type="hidden" name="responsable_id" id="hid-responsable-id"
                value="<%= area && area.responsable_id ? area.responsable_id : '' %>">
              <input type="text" id="inp-responsable" maxlength="100"
                autocomplete="off"
                value="<%= area && area.jefe_nombre ? area.jefe_nombre : '' %>"
                placeholder="Buscar personal interno...">
              <div id="drop-responsable" class="dir-dropdown" style="display:none"></div>
            </div>
            <% if (area && area.jefe_nombre) { %>
              <div style="margin-top:4px;font-size:11px;color:var(--gris)">
                Actual: <strong><%= area.jefe_nombre %></strong><% if (area.jefe_cargo) { %> — <%= area.jefe_cargo %><% } %>
                &nbsp;<a href="#" id="lnk-quitar-jefe" style="color:var(--rojo);text-decoration:none;font-size:11px">✕ quitar</a>
              </div>
            <% } %>
          </div>
          <div class="form-group" style="grid-column:1/-1">
            <label>Descripción</label>
            <input type="text" name="descripcion" maxlength="255"
              value="<%= area && area.descripcion ? area.descripcion : '' %>"
              placeholder="Breve descripción del área (opcional)">
          </div>
        </div>
        <div class="flex gap-8 mt-16">
          <button type="submit" class="btn btn-primary"><%= area ? 'Guardar cambios' : 'Crear área' %></button>
          <a href="/areas" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>
<script src="/js/app.js"></script>
<script>
(function () {
  var inp  = document.getElementById('inp-responsable');
  var drop = document.getElementById('drop-responsable');
  var hid  = document.getElementById('hid-responsable-id');
  var lnkQuitar = document.getElementById('lnk-quitar-jefe');
  if (!inp || !drop) return;

  if (lnkQuitar) {
    lnkQuitar.addEventListener('click', function (e) {
      e.preventDefault();
      inp.value = '';
      if (hid) hid.value = '';
      lnkQuitar.parentElement.style.display = 'none';
    });
  }

  var timer = null;
  var ultima = '';

  function esc(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function ocultar() { drop.style.display = 'none'; }

  function mostrar(lista) {
    drop.innerHTML = '';
    if (!lista || lista.length === 0) {
      drop.innerHTML = '<div class="dir-no-results">Sin resultados en el directorio interno.</div>';
      drop.style.display = 'block';
      return;
    }
    lista.forEach(function (f) {
      var linea2 = [f.cargo, f.area_nombre].filter(Boolean).join(' · ');
      var el = document.createElement('div');
      el.className = 'dir-item';
      el.innerHTML =
        '<div class="dir-item-tipo int">I</div>' +
        '<div class="dir-item-info">' +
          '<div class="dir-item-nombre">' + esc(f.nombre) + '</div>' +
          '<div class="dir-item-sub">'   + esc(linea2 || '—') + '</div>' +
        '</div>';
      el.addEventListener('mousedown', function (e) {
        e.preventDefault();
        inp.value = f.nombre;
        if (hid) hid.value = f.id;
        ocultar();
      });
      drop.appendChild(el);
    });
    drop.style.display = 'block';
  }

  function buscar(q) {
    q = (q || '').trim();
    if (!q) { ocultar(); return; }
    ultima = q;
    drop.innerHTML = '<div class="dir-no-results">Buscando...</div>';
    drop.style.display = 'block';

    fetch('/directorio/buscar?q=' + encodeURIComponent(q) + '&tipo=interno', {
      credentials: 'include',
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    })
    .then(function (data) {
      if (ultima === q) mostrar(data);
    })
    .catch(function (err) {
      console.error('Autocomplete responsable:', err);
      drop.innerHTML = '<div class="dir-no-results" style="color:var(--rojo)">Error al buscar.</div>';
      drop.style.display = 'block';
    });
  }

  inp.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () { buscar(inp.value); }, 280);
  });

  inp.addEventListener('focus', function () {
    if (inp.value.trim()) buscar(inp.value);
  });

  document.addEventListener('click', function (e) {
    if (!inp.contains(e.target) && !drop.contains(e.target)) ocultar();
  });
}());
</script>
</body></html>
